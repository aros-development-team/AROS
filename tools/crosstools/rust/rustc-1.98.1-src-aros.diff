+// POSIX functions the AROS C library does not provide. They are defined
+// here, with the C symbol names, so that std's shared unix code links and
+// reports ENOSYS at run time instead of leaving undefined symbols behind
+// (the AROS loader refuses those). Sockets live in bsdsocket.library and
+// need its library base, so they are not reachable from here either.
+macro_rules! aros_enosys {
+    ($($(#[$attr:meta])* $vis:vis fn $name:ident($($arg:ident: $ty:ty),* $(,)?) -> $ret:ty;)*) => {$(
+        $(#[$attr])*
+        #[no_mangle]
+        #[allow(dead_code, unused_variables)]
+        $vis unsafe extern "C" fn $name($($arg: $ty),*) -> $ret {
+            *__stdc_geterrnoptr() = ENOSYS;
+            !0usize as $ret
+        }
+    )*};
+}
