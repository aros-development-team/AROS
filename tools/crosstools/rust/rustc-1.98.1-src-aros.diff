+use crate::spec::{Arch, CodeModel, StackProbeType, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::aros::opts();
+    base.features = "+v8a".into();
+    base.max_atomic_width = Some(128);
+    base.stack_probes = StackProbeType::Inline;
+    // AROS aarch64 user space is built with -mcmodel=large -fno-pic -fno-pie.
+    base.code_model = Some(CodeModel::Large);
+    base.linker = Some("aarch64-aros-cc".into());
+
+    Target {
+        llvm_target: "aarch64-unknown-none".into(),
+        metadata: TargetMetadata {
+            description: Some("ARM64 AROS".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout: "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32".into(),
+        arch: Arch::AArch64,
+        options: base,
+    }
+}
