@@ -0,0 +1,33 @@
+use std::borrow::Cow;
+
+use crate::spec::{
+    Arch, CodeModel, LlvmAbi, SplitDebuginfo, Target, TargetMetadata, base,
+};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::aros::opts();
+    // AROS riscv64 is built -march=<rva22u64 by default> -mabi=lp64d
+    // -mcmodel=medany; rv64gc is the portable baseline, extensions are
+    // opted into with -C target-feature.
+    base.code_model = Some(CodeModel::Medium);
+    base.cpu = "generic-rv64".into();
+    base.features = "+m,+a,+f,+d,+c,+zicsr,+zifencei".into();
+    base.llvm_abiname = LlvmAbi::Lp64d;
+    base.max_atomic_width = Some(64);
+    base.supported_split_debuginfo = Cow::Borrowed(&[SplitDebuginfo::Off]);
+    base.linker = Some("riscv64-aros-cc".into());
+
+    Target {
+        llvm_target: "riscv64-unknown-none-elf".into(),
+        metadata: TargetMetadata {
+            description: Some("RISC-V AROS (rv64gc)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout: "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128".into(),
+        arch: Arch::RiscV64,
+        options: base,
+    }
+}
