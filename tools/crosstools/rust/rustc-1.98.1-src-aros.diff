@@ -0,0 +1,27 @@
+use crate::spec::{Arch, Cc, LinkerFlavor, Lld, StackProbeType, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::aros::opts();
+    // AROS i386 is built for the i486 baseline (no SSE, no cmpxchg8b).
+    base.cpu = "i486".into();
+    base.max_atomic_width = Some(32);
+    base.stack_probes = StackProbeType::Inline;
+    base.linker = Some("i386-aros-cc".into());
+    base.add_pre_link_args(LinkerFlavor::Gnu(Cc::Yes, Lld::No), &["-m32"]);
+
+    Target {
+        llvm_target: "i686-unknown-none-elf".into(),
+        metadata: TargetMetadata {
+            description: Some("32-bit AROS (i486 baseline)".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 32,
+        data_layout: "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-\
+            i128:128-f64:32:64-f80:32-n8:16:32-S128"
+            .into(),
+        arch: Arch::X86,
+        options: base,
+    }
+}
