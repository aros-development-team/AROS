@@ -0,0 +1,27 @@
+use crate::spec::{Arch, CfgAbi, FloatAbi, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::aros::opts();
+    // AROS ARM ("armhf") is built -marm -mfloat-abi=hard for an ARMv6+VFP
+    // baseline (Raspberry Pi 1 and up); newer cores are opted into with
+    // -C target-cpu / -C target-feature.
+    base.cfg_abi = CfgAbi::EabiHf;
+    base.llvm_floatabi = Some(FloatAbi::Hard);
+    base.features = "+strict-align,+v6,+vfp2,-d32,-thumb-mode".into();
+    base.max_atomic_width = Some(64);
+    base.linker = Some("arm-aros-cc".into());
+
+    Target {
+        llvm_target: "armv6-unknown-none-eabihf".into(),
+        metadata: TargetMetadata {
+            description: Some("ARMv6 AROS, hardfloat".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 32,
+        data_layout: "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64".into(),
+        arch: Arch::Arm,
+        options: base,
+    }
+}
