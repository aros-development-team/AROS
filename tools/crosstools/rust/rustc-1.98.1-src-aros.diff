diff -ruN -x build -x bootstrap.toml -x '*.orig' -x '*.rej' rustc-1.98.1-src.orig/compiler/rustc_target/src/spec/base/aros.rs rustc-1.98.1-src/compiler/rustc_target/src/spec/base/aros.rs
--- rustc-1.98.1-src.orig/compiler/rustc_target/src/spec/base/aros.rs	1970-01-01 00:00:00.000000000 +0000
+++ rustc-1.98.1-src/compiler/rustc_target/src/spec/base/aros.rs	2026-09-14 12:06:24.413770265 +0000
@@ -0,0 +1,43 @@
+use crate::spec::{Cc, LinkerFlavor, Lld, Os, PanicStrategy, RelocModel, TargetOptions, cvs};
+
+/// Shared options for the AROS targets.
+///
+/// AROS executables are relocatable ELF objects: the AROS loader applies the
+/// relocations itself, so there is no dynamic linker, no PIC/PIE and no ELF
+/// TLS. The C driver of the AROS cross toolchain (gcc or clang) supplies the
+/// start-up objects and the default libraries, and performs the final
+/// relocatable link through `collect-aros`.
+pub(crate) fn opts() -> TargetOptions {
+    TargetOptions {
+        os: Os::Aros,
+        families: cvs!["unix"],
+        linker_flavor: LinkerFlavor::Gnu(Cc::Yes, Lld::No),
+        dynamic_linking: false,
+        executables: true,
+        relocation_model: RelocModel::Static,
+        position_independent_executables: false,
+        static_position_independent_executables: false,
+        plt_by_default: false,
+        has_thread_local: false,
+        // Everything is linked statically anyway, but the AROS driver must
+        // not see -static: its spec then drops posixc.library's link library.
+        crt_static_default: false,
+        crt_static_respected: false,
+        crt_static_allows_dylibs: false,
+        // No unwinder is linked into AROS programs: panics abort.
+        panic_strategy: PanicStrategy::Abort,
+        eh_frame_header: false,
+        default_uwtable: false,
+        // The AROS driver adds the C library, start-up code and system
+        // link libraries; do not suppress them with -nodefaultlibs.
+        no_default_libraries: false,
+        // collect-aros performs a relocatable link (ld -r), which has no
+        // entry point for --gc-sections to anchor on; undo the flag rustc
+        // adds by default.
+        post_link_args: TargetOptions::link_args(
+            LinkerFlavor::Gnu(Cc::Yes, Lld::No),
+            &["-Wl,--no-gc-sections"],
+        ),
+        ..Default::default()
+    }
+}
