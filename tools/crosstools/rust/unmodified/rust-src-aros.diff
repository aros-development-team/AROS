+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 John Knipper
+
+use crate::ffi::{OsStr, OsString};
+use crate::path::{Path, PathBuf, Prefix};
+use crate::{env, io};
+
+pub(crate) mod lex;
+path_separator_bytes!(b'/');
+pub const HAS_PREFIXES: bool = true;
+#[inline]
+pub const fn is_verbatim_sep(byte: u8) -> bool { is_sep_byte(byte) }
+
+pub fn parse_prefix(path: &OsStr) -> Option<Prefix<'_>> {
+    let bytes = path.as_encoded_bytes();
+    lex::volume_end(bytes).map(|end| {
+        // ASCII colon boundary preserves OsStr's encoding invariant.
+        Prefix::ArosVolume(unsafe { OsStr::from_encoded_bytes_unchecked(&bytes[..end - 1]) })
+    })
+}
+
+pub(crate) fn is_absolute(path: &Path) -> bool { parse_prefix(path.as_os_str()).is_some() }
+
+pub(crate) fn push(base: &mut OsString, suffix: &OsStr) {
+    let (keep, separator) = lex::push_plan(base.as_encoded_bytes(), suffix.as_encoded_bytes());
+    base.truncate(keep);
+    if separator { base.push("/"); }
+    base.push(suffix);
+}
+
+pub(crate) fn absolute(path: &Path) -> io::Result<PathBuf> {
+    if is_absolute(path) { return Ok(path.to_path_buf()); }
+    // A current-volume colon or parent slash needs the current DOS directory.
+    // Keep parent traversal and dot names lexical; do not canonicalize a path
+    // that may not exist or resolve its assigns/symlinks here.
+    let mut absolute = env::current_dir()?;
+    absolute.push(path);
+    Ok(absolute)
+}
