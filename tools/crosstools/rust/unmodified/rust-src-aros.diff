+#![cfg(target_os = "aros")]
+#![feature(path_trailing_sep)]
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 John Knipper
+use std::path::{self, Component, Path, PathBuf, Prefix};
+use std::ffi::OsStr;
+use std::os::unix::ffi::OsStrExt;
+use std::hash::{Hash, Hasher};
+fn hash(p: &Path) -> u64 {
+    let mut h = std::collections::hash_map::DefaultHasher::new(); p.hash(&mut h); h.finish()
+}
+#[test]
+fn qualified_volume_basics() {
+    for root in ["T:", "RAM Disk:", "SYS:"] {
+        let root = Path::new(root);
+        assert!(root.is_absolute()); assert!(root.has_root());
+        assert_eq!(root.file_name(), None); assert_eq!(root.parent(), None);
+        assert_eq!(path::absolute(root).unwrap().as_os_str(), root.as_os_str());
+    }
+    let p = Path::new("RAM:foo");
+    assert_eq!(p.file_name(), Some(OsStr::new("foo")));
+    assert_eq!(p.parent(), Some(Path::new("RAM:")));
+    assert_eq!(p.strip_prefix("RAM:").unwrap(), Path::new("foo"));
+    assert_eq!(Path::new("T:").join("foo").as_os_str(), "T:foo");
+}
+#[test]
+fn volume_prefix_api_and_component_spellings() {
+    let mut c = Path::new("RAM Disk:foo").components();
+    match c.next().unwrap() {
+        Component::Prefix(p) => { assert_eq!(p.kind(), Prefix::ArosVolume(OsStr::new("RAM Disk"))); assert_eq!(p.as_os_str(), "RAM Disk:"); }
+        other => panic!("unexpected {other:?}"),
+    }
+    assert_eq!(c.as_path().as_os_str(), ":foo");
+    assert_eq!(c.next(), Some(Component::RootDir));
+    assert_eq!(Component::RootDir.as_os_str(), ":");
+    assert_eq!(Component::ParentDir.as_os_str(), "/");
+    assert_eq!(c.as_path().as_os_str(), "foo");
+    assert_eq!(c.next_back(), Some(Component::Normal(OsStr::new("foo"))));
+    assert_eq!(c.next(), None);
+}
+#[test]
+fn native_push_parent_and_volume_replacement() {
+    let mut p = PathBuf::from("SYS:old/dir");
+    p.push("RAM Disk:new"); assert_eq!(p.as_os_str(), "RAM Disk:new");
+    p.push(":root"); assert_eq!(p.as_os_str(), "RAM Disk:root");
+    p.push("/sibling"); assert_eq!(p.as_os_str(), "RAM Disk:root//sibling");
+    assert!(!Path::new("/foo").is_absolute()); assert!(!Path::new("/foo").has_root());
+    assert!(!Path::new(":foo").is_absolute()); assert!(Path::new(":foo").has_root());
+    assert_eq!(p.parent().unwrap().as_os_str(), "RAM Disk:root//");
+}
+#[test]
+fn eq_hash_ord_and_literal_names() {
+    assert_eq!(Path::new("a/"), Path::new("a"));
+    assert_eq!(hash(Path::new("a/")), hash(Path::new("a")));
+    assert_eq!(Path::new("a/").cmp(Path::new("a")), std::cmp::Ordering::Equal);
+    for (a,b) in [("a//b","a/b"),("a/./b","a/b"),("..","/"),("RAM:","ram:")] {
+        assert_ne!(Path::new(a), Path::new(b));
+    }
+    let raw = Path::new(OsStr::from_bytes(b"RAM Disk:copi\xe9.txt"));
+    assert!(raw.is_absolute());
+    assert_eq!(raw.file_name().unwrap().as_bytes(), b"copi\xe9.txt");
+    assert_eq!(raw.parent().unwrap().as_os_str(), "RAM Disk:");
+}
+#[test]
+fn component_collection_extension_pop_and_file_name() {
+    for text in ["", "T:", "RAM:foo", ":foo", "/foo", "dir//file", "dir///", "a/./../b", "RAM:/a//b"] {
+        let p = Path::new(text);
+        let c: PathBuf = p.components().collect();
+        assert_eq!(c, p, "collect {text}");
+        let mut ext = PathBuf::new(); ext.extend(p.components()); assert_eq!(ext, p);
+        let forward: Vec<_> = p.components().collect();
+        assert_eq!(forward.iter().rev().copied().collect::<Vec<_>>(), p.components().rev().collect::<Vec<_>>());
+        for split in 0..=forward.len() {
+            let mut it = p.components();
+            for expected in &forward[..split] { assert_eq!(it.next(), Some(*expected)); }
+            for expected in forward[split..].iter().rev() { assert_eq!(it.next_back(), Some(*expected)); }
+            assert_eq!(it.next(), None); assert_eq!(it.next_back(), None);
+        }
+    }
+    let mut p = PathBuf::from("RAM:foo"); p.set_file_name("bar"); assert_eq!(p.as_os_str(), "RAM:bar");
+    assert!(p.pop()); assert_eq!(p.as_os_str(), "RAM:"); assert!(!p.pop());
+}
+#[test]
+fn strip_prefix_parents_and_trailing_operations() {
+    assert_eq!(Path::new("RAM:dir//file").strip_prefix("RAM:dir").unwrap().as_os_str(), "/file");
+    assert_eq!(Path::new("RAM:dir//file").strip_prefix("RAM:dir//").unwrap().as_os_str(), "file");
+    assert_eq!(Path::new("a/").trim_trailing_sep().as_os_str(), "a");
+    assert_eq!(Path::new("a//").trim_trailing_sep().as_os_str(), "a//");
+    assert_eq!(Path::new("/").trim_trailing_sep().as_os_str(), "/");
+    let mut root = PathBuf::from("T:"); root.push_trailing_sep(); assert_eq!(root.as_os_str(), "T:"); assert!(root.has_trailing_sep());
+}
