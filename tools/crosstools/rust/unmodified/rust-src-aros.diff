+// Unsupported POSIX calls report ENOSYS. Native network and positioned-I/O
+// operations use their dedicated AROS adapters.
+// Pointer and interface-index results have their own zero failure sentinel.
+// One native provider serves std and application libc versions. Declarations
+// carry explicit adapter names; this crate exports no replacement C bodies.
+macro_rules! aros_unavailable {
+    ($($(#[$attr:meta])* $vis:vis fn $name:ident($($arg:ident: $ty:ty),* $(,)?) -> $ret:ty;)*) => {
+        unsafe extern "C" { $(
+            $(#[$attr])*
+            #[link_name = ::core::concat!("aros_rs_", ::core::stringify!($name))]
+            $vis fn $name($($arg: $ty),*) -> $ret;
+        )*}
+    };
+}
