+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 John Knipper
+// Byte grammar shared by the AROS std backend and standalone host regression tests.
+// Only ASCII delimiters are examined; arbitrary OsStr bytes are retained.
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Kind { Prefix, Root, Parent, Normal }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Token { pub kind: Kind, pub start: usize, pub end: usize }
+
+pub(crate) fn volume_end(bytes: &[u8]) -> Option<usize> {
+    for (i, &byte) in bytes.iter().enumerate() {
+        match byte {
+            b':' => return if i == 0 { None } else { Some(i + 1) },
+            b'/' => return None,
+            _ => {}
+        }
+    }
+    None
+}
+
+/// No allocation, no filesystem lookup, and no POSIX dot/slash normalization.
+/// A volume prefix owns its colon; the Root token is an implicit overlapping
+/// view of that colon, as Windows UNC prefixes also have an implicit root.
+#[derive(Clone, Debug)]
+pub(crate) struct Lexer<'a> {
+    bytes: &'a [u8],
+    front: usize,
+    back: usize,
+    prefix_end: usize,
+    prefix_pending: bool,
+    root_pending: bool,
+}
+impl<'a> Lexer<'a> {
+    pub(crate) fn new(bytes: &'a [u8]) -> Self {
+        let prefix_end = volume_end(bytes).unwrap_or(0);
+        Self { bytes, front: 0, back: bytes.len(), prefix_end,
+            prefix_pending: prefix_end != 0,
+            root_pending: prefix_end != 0 || bytes.first() == Some(&b':') }
+    }
+    pub(crate) fn has_root(&self) -> bool {
+        self.prefix_end != 0 || self.bytes.first() == Some(&b':')
+    }
+    fn body_start(&self) -> usize {
+        if self.prefix_pending || self.root_pending {
+            if self.prefix_end != 0 { self.prefix_end } else { 1 }
+        } else { self.front }
+    }
+    pub(crate) fn slice(&self, token: Token) -> &'a [u8] {
+        &self.bytes[token.start..token.end]
+    }
+    pub(crate) fn remaining(&self) -> &'a [u8] {
+        let mut end = self.back;
+        let start = self.body_start();
+        // One slash after a name is a delimiter, not an extra parent token.
+        if end >= start + 2 && self.bytes[end - 1] == b'/'
+            && self.bytes[end - 2] != b'/' {
+            end -= 1;
+        }
+        // A prefix-only iterator still exposes its complete raw spelling,
+        // including the implicit root colon (the same limitation as UNC roots).
+        if self.prefix_pending && !self.root_pending && end < self.prefix_end {
+            end = self.prefix_end;
+        }
+        &self.bytes[self.front.min(end)..end]
+    }
+}
+impl Iterator for Lexer<'_> {
+    type Item = Token;
+    fn next(&mut self) -> Option<Token> {
+        if self.prefix_pending {
+            self.prefix_pending = false;
+            let token = Token { kind: Kind::Prefix, start: 0, end: self.prefix_end };
+            self.front = if self.root_pending { self.prefix_end - 1 } else { self.back };
+            return Some(token);
+        }
+        if self.root_pending {
+            self.root_pending = false;
+            let start = self.front;
+            self.front += 1;
+            return Some(Token { kind: Kind::Root, start, end: start + 1 });
+        }
+        if self.front >= self.back { return None; }
+        let start = self.front;
+        if self.bytes[start] == b'/' {
+            self.front += 1;
+            return Some(Token { kind: Kind::Parent, start, end: self.front });
+        }
+        let end = self.bytes[start..self.back].iter().position(|&b| b == b'/')
+            .map_or(self.back, |n| start + n);
+        self.front = if end < self.back { end + 1 } else { end };
+        Some(Token { kind: Kind::Normal, start, end })
+    }
+}
+impl DoubleEndedIterator for Lexer<'_> {
+    fn next_back(&mut self) -> Option<Token> {
+        let body = self.body_start();
+        if self.back > body {
+            if self.bytes[self.back - 1] == b'/' {
+                // Only inspect the preceding byte: walking the complete run
+                // for each parent would make reverse iteration quadratic.
+                if self.back == body + 1 || self.bytes[self.back - 2] == b'/' {
+                    self.back -= 1;
+                    return Some(Token { kind: Kind::Parent, start: self.back, end: self.back + 1 });
+                }
+                // The only trailing slash is the delimiter after a normal name.
+                self.back -= 1;
+            }
+            let end = self.back;
+            let start = self.bytes[body..end].iter().rposition(|&b| b == b'/')
+                .map_or(body, |n| body + n + 1);
+            self.back = start;
+            // Remove a separating slash after an earlier normal name, but never
+            // a slash that denotes a parent (including a leading slash).
+            if start >= body + 2 && self.bytes[start - 1] == b'/'
+                && self.bytes[start - 2] != b'/' {
+                self.back -= 1;
+            }
+            return Some(Token { kind: Kind::Normal, start, end });
+        }
+        if self.root_pending {
+            self.root_pending = false;
+            let start = if self.prefix_end != 0 { self.prefix_end - 1 } else { 0 };
+            self.back = start;
+            return Some(Token { kind: Kind::Root, start, end: start + 1 });
+        }
+        if self.prefix_pending {
+            self.prefix_pending = false;
+            self.front = self.back;
+            return Some(Token { kind: Kind::Prefix, start: 0, end: self.prefix_end });
+        }
+        None
+    }
+}
+impl core::iter::FusedIterator for Lexer<'_> {}
+
+/// DOS AddPart's lexical base retention and separator insertion decisions.
+/// The returned length retains the base prefix. The caller appends `suffix`
+/// verbatim after optionally inserting one separating slash.
+pub(crate) fn push_plan(base: &[u8], suffix: &[u8]) -> (usize, bool) {
+    if volume_end(suffix).is_some() { return (0, false); }
+    if suffix.first() == Some(&b':') {
+        return (volume_end(base).map_or(0, |end| end - 1), false);
+    }
+    let separator = base.last().is_some_and(|&b| b != b':' && b != b'/');
+    (base.len(), separator)
+}
