+// AROS keeps the process environment behind stdcio.library: the C start-up
+// registers the address of its `environ` with it, and programs that never did
+// so get a null pointer back.
+#[cfg(target_os = "aros")]
+pub unsafe fn environ() -> *mut *const *const c_char {
+    static mut EMPTY_ENVIRON: *const *const c_char = crate::ptr::null();
+    let environ = unsafe { libc::__stdcio_get_environptr() } as *mut *const *const c_char;
+    if environ.is_null() { &raw mut EMPTY_ENVIRON } else { environ }
