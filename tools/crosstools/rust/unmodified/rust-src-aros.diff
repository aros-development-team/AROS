+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 John Knipper
+// Shared Path integration for the native DOS grammar only.
+use super::*;
+use crate::sys::path::lex::{Kind, Token};
+
+impl<'a> Components<'a> {
+    #[must_use]
+    #[stable(feature = "rust1", since = "1.0.0")]
+    pub fn as_path(&self) -> &'a Path {
+        // The lexer only splits at ASCII ':' and '/' byte boundaries.
+        unsafe { Path::from_u8_slice(self.inner.remaining()) }
+    }
+    pub(super) fn has_root(&self) -> bool { self.inner.has_root() }
