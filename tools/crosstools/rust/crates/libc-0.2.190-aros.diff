+// POSIX functions the AROS C library does not provide. They are defined
+// here, with the C symbol names, so that std's shared unix code links and
+// reports ENOSYS at run time instead of leaving undefined symbols behind
+// (the AROS loader refuses those). Sockets live in bsdsocket.library and
+// need its library base, so they are not reachable from here either.
+/// posixc has `pread`, but the Rust crosstool's own libc crate (the one the standard library
+/// is built with) defines a stub of that name, and the linker would pull its object file in
+/// for `pread` alone and then see every other stub twice. Defining `pread` here, as a call to
+/// posixc's `pread64`, keeps that object out of the link.
+#[no_mangle]
+pub unsafe extern "C" fn pread(fd: c_int, buf: *mut c_void, count: size_t, offset: off_t) -> isize {
+    pread64(fd, buf, count, offset as i64)
+}
+
+/// AROS has no `fork()`, so there is nothing for fork handlers to do; the registration
+/// succeeds and the handlers are dropped (rand's thread_rng registers one).
+#[no_mangle]
+pub unsafe extern "C" fn pthread_atfork(
+    prepare: Option<unsafe extern "C" fn()>,
+    parent: Option<unsafe extern "C" fn()>,
+    child: Option<unsafe extern "C" fn()>,
+) -> c_int {
+    let _ = (prepare, parent, child);
+    0
+}
+
+macro_rules! aros_enosys {
+    ($($(#[$attr:meta])* $vis:vis fn $name:ident($($arg:ident: $ty:ty),* $(,)?) -> $ret:ty;)*) => {$(
+        $(#[$attr])*
+        #[no_mangle]
+        #[allow(dead_code, unused_variables)]
+        $vis unsafe extern "C" fn $name($($arg: $ty),*) -> $ret {
+            *__stdc_geterrnoptr() = ENOSYS;
+            !0usize as $ret
+        }
+    )*};
+}
