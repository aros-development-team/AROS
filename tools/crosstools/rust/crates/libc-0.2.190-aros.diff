+
+    // The pthread.library synchronisation objects embed exec.library
+    // structures (SignalSemaphore, MinList) whose size depends on the CPU
+    // and on the kernel's spinlock isolation. They are only ever handled
+    // through pointers, so they are modelled as opaque, 8-byte aligned
+    // blocks that are at least as large as any AROS build defines them
+    // (x86_64 SMP: mutex 248, cond 264, sem 552 bytes).
+    pub struct pthread_mutex_t {
+        __private: [u64; 32],
+    }
+
+    pub struct pthread_cond_t {
+        __private: [u64; 40],
+    }
+
+    pub struct pthread_rwlock_t {
+        __private: [u64; 32],
+    }
+
+    pub struct sem_t {
+        __private: [u64; 72],
+    }
+
+    // Networking is not provided by the C library on AROS (bsdsocket.library
+    // is reached through its library base); these definitions only satisfy
+    // the shared unix declarations.
+    pub struct sockaddr {
+        pub sa_len: u8,
+        pub sa_family: sa_family_t,
+        pub sa_data: [c_char; 14],
+    }
+
+    pub struct sockaddr_in {
