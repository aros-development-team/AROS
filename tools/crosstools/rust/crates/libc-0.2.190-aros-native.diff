+//! Bindings for the AROS C library (posixc.library / stdc.library) and
+//! pthread.library, as shipped in the AROS SDK.
+//!
+//! Type widths and structure layouts follow the SDK headers
+//! (`aros/types/*.h`, `aros/posixc/*.h`, `pthread.h`). They were verified
+//! against the x86_64 and riscv64 cross compilers; the 32-bit variants
+//! follow the same headers through `__WORDSIZE`.
+
+use crate::prelude::*;
+
+pub type blkcnt_t = c_long;
+pub type blksize_t = c_long;
+pub type clock_t = c_ulong;
