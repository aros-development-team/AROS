+// AROS sys/socket.h aligns ancillary records with AROS_ALIGN (16 bytes on
+// aarch64). These helpers only describe buffers; they introduce no C symbols.
+#[cfg(all(target_os = "aros", target_arch = "aarch64"))]
+#[allow(non_snake_case)]
+mod aros_cmsg {
+    use super::*;
+    const fn aligned(n: usize) -> usize { (n + 15) & !15 }
+    pub const unsafe fn CMSG_SPACE(n: u32) -> usize {
+        aligned(core::mem::size_of::<cmsghdr>()) + aligned(n as usize)
+    }
+    pub const unsafe fn CMSG_LEN(n: u32) -> usize {
+        aligned(core::mem::size_of::<cmsghdr>()) + n as usize
+    }
+    pub unsafe fn CMSG_DATA(header: *const cmsghdr) -> *mut u8 {
+        (header as *mut u8).add(aligned(core::mem::size_of::<cmsghdr>()))
+    }
+    pub unsafe fn CMSG_FIRSTHDR(msg: *const msghdr) -> *mut cmsghdr {
+        if (*msg).msg_controllen as usize >= core::mem::size_of::<cmsghdr>() {
+            (*msg).msg_control.cast()
+        } else { core::ptr::null_mut() }
+    }
+    pub unsafe fn CMSG_NXTHDR(msg: *const msghdr, header: *const cmsghdr) -> *mut cmsghdr {
+        if header.is_null() { return CMSG_FIRSTHDR(msg); }
+        let next = (header as usize).checked_add(aligned((*header).cmsg_len as usize));
+        let end = ((*msg).msg_control as usize).checked_add((*msg).msg_controllen as usize);
+        match (next, end) {
+            (Some(next), Some(end)) if next.checked_add(aligned(core::mem::size_of::<cmsghdr>()))
+                .is_some_and(|header_end| header_end <= end) => next as *mut cmsghdr,
+            _ => core::ptr::null_mut(),
+        }
+    }
+}
