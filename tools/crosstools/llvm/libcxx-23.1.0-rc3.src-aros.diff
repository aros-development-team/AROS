--- llvm-project-23.1.0-rc3.src/libcxx/include/__locale_dir/locale_base_api.h	2026-08-19 15:37:15.664463931 +0100
+++ llvm-project-23.1.0-rc3.src.aros/libcxx/include/__locale_dir/locale_base_api.h	2026-08-19 15:37:15.666201131 +0100
@@ -134,7 +134,13 @@
 //       (by providing global non-reserved names) and the new API. As we move individual platforms
 //       towards the new way of defining the locale base API, this should disappear since each platform
 //       will define those directly.
-#    include <__locale_dir/locale_base_api/ibm.h>
+// AROS: this bridge header redeclares the C library entry points with an
+// abi_tag, which clashes with AROS's own declarations. libc++ 20 reached this
+// point with no platform header included at all and worked from the generic
+// declarations below, so keep doing that.
+#    ifndef __AROS__
+#      include <__locale_dir/locale_base_api/ibm.h>
+#    endif
 
 #    include <__locale_dir/locale_base_api/bsd_locale_fallbacks.h>
 
diff -ruN llvm-project-23.1.0-rc3.src/libcxx/src/chrono.cpp llvm-project-23.1.0-rc3.src.aros/libcxx/src/chrono.cpp
--- llvm-project-23.1.0-rc3.src/libcxx/src/chrono.cpp	2026-08-19 13:30:01.500159892 +0100
+++ llvm-project-23.1.0-rc3.src.aros/libcxx/src/chrono.cpp	2026-08-19 13:30:01.497401292 +0100
@@ -36,7 +36,7 @@
 
 // OpenBSD and GPU do not have a fully conformant suite of POSIX timers, but
 // it does have clock_gettime and CLOCK_MONOTONIC which is all we need.
-#if defined(__APPLE__) || defined(__gnu_hurd__) || defined(__OpenBSD__) || defined(__AMDGPU__) ||                      \
+#if defined(__AROS__) || defined(__APPLE__) || defined(__gnu_hurd__) || defined(__OpenBSD__) || defined(__AMDGPU__) ||                      \
     defined(__NVPTX__) || (defined(_POSIX_TIMERS) && _POSIX_TIMERS > 0)
 #  define _LIBCPP_HAS_CLOCK_GETTIME
 #endif
