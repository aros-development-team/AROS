USER_LDFLAGS := -static

# This pressure test is selected by the native Amiga graphics test group.
#MM test-graphics-regionpool : includes linklibs
%build_progs mmake=test-graphics-regionpool \
    files=regionpool targetdir=$(AROS_TESTS)/graphics/regionpool

%common
