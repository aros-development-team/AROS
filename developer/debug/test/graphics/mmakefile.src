include $(SRCDIR)/config/aros.cfg

FILES := \
    allocbitmap \
    alphascreen \
    areatest2 \
    blttemplatealpha \
    CGXTest \
    copper \
    getcybermapattr \
    gfx \
    gfxinfo \
    gfxtest \
    obtainpentest \
    readpixelarray \
    scalepixelarray \
    showvisregion \
    showvisshape \
    testarrayops \
    textbug \
    truecolorpens \
    weightamatch \
    wpaaglobal \
    writepixelarray \
    writepixelarrayalpha

EXEDIR := $(AROS_TESTS)/graphics

#MM- test : test-graphics
#MM- test-quick : test-graphics-quick

#MM test-graphics : includes linklibs test-graphics-classicviewport test-graphics-classicsprites
#MM- test-graphics-quick : test-graphics-classicviewport-quick test-graphics-classicsprites-quick

%build_progs mmake=test-graphics \
    files=$(FILES) targetdir=$(EXEDIR)

%common
