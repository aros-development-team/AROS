#
#   Makefile for AROS kernel.resource tests

include $(SRCDIR)/config/aros.cfg

FILES := mmap stackcheck mmio

EXEDIR := $(AROS_TESTS)/kernel

#MM test-kernel : includes includes-copy linklibs includes-kernel

%build_progs mmake=test-kernel \
    files=$(FILES) targetdir=$(EXEDIR)

# fdtprobe reads the firmware's device tree, so it needs the parser the
# riscv port keeps as a linklib - and the parser uses strcmp(), hence
# the static link.
USER_INCLUDES := -I$(SRCDIR)/arch/riscv-all/linklibs/fdt/include

#MM test-kernel : linklibs-fdt

%build_prog mmake=test-kernel \
    files=fdtprobe targetdir=$(EXEDIR) progname=FDTProbe \
    uselibs="fdt"

%common
