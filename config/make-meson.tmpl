#         Meson build system. Incorporated into the build via %include
#         from make.tmpl.

#------------------------------------------------------------------------------
# Build an imported source tree which uses meson
#
# For target builds the cross environment is described by the meson cross
# file generated by configure ($(GENDIR)/config/conf.meson, from
# config/conf.meson.in). Compiler and linker flags are passed on the meson
# command line since they override the cross file's [built-in options].
#
# Requires meson and ninja on the host (detected by configure, available
# as $(MESON) and $(NINJA) from host.cfg).
#
# Arguments:
#
#     - mmake           = the meta make target.
#     - package         = name of the package to be built.
#     - srcdir          = the location of the unpacked source code. Defaults
#                         to $(SRCDIR)/$(CURDIR).
#     - gendir          = override the base directory the build is performed in.
#     - prefix          = the install directory. Must be an absolute path of the
#                         host system. Defaults to $(AROS_CONTRIB).
#     - extraoptions    = additional options for meson setup (e.g. -Dfoo=bar).
#     - compiler        = target or host. Defaults to target.
#     - buildtype       = meson build type. Defaults to release.
#     - mesonbuildcmd   = override the command used to perform the build.
#     - mesoninstallcmd = override the command used to install.
#     - cleanafterbuild = if yes the build directory is cleaned after
#                         installing. Defaults to no.
#     - cleandir        = directory removed if cleaning after build fails.
#                         Defaults to the build directory.
#     - premeson        = a metatarget which is executed before meson setup.
#     - postmeson       = a metatarget which is executed after meson setup.
#     - usecflags       = include the build system's C flags. Defaults to yes.
#     - extracflags     = additional flags to use with the C compiler.
#     - usecxxflags     = include the build system's C++ flags. Defaults to yes.
#     - extracxxflags   = additional flags to use with the C++ compiler.
#     - usecppflags     = include the build system's preprocessor flags
#                         (folded into the compiler flags). Defaults to yes.
#     - extracppflags   = additional preprocessor flags.
#     - extraldflags    = additional linker flags.
#     - usecrosstoolsdir = for host builds, add $(CROSSTOOLSDIR) include/lib
#                         paths. Defaults to yes.
#

%define build_with_meson mmake=/A package= srcdir="$(SRCDIR)/$(CURDIR)" gendir= prefix= \
    aros_prefix= extraoptions= compiler=target buildtype=release \
    mesonbuildcmd= mesoninstallcmd= cleanafterbuild=no cleandir= \
    premeson= postmeson= \
    usecppflags=yes extracppflags= \
    usecflags=yes extracflags= \
    usecxxflags=yes extracxxflags= \
    extraldflags= \
    usecrosstoolsdir=yes

ifneq (%(prefix),)
    %(mmake)-prefix          := %(prefix)
else
    %(mmake)-prefix          := $(AROS_CONTRIB)
endif

ifneq (%(aros_prefix),)
    %(mmake)-aros_prefix     := %(aros_prefix)
else
    %(mmake)-aros_prefix     := $(%(mmake)-prefix)
endif

%(mmake)-meson_opts          := --prefix=$(%(mmake)-prefix) --libdir=lib
ifeq (,$(findstring --buildtype,%(extraoptions)))
    %(mmake)-meson_opts      += --buildtype=%(buildtype)
endif

ifeq (%(compiler),host)
    %(mmake)-meson-env := CC="$(strip $(HOST_DEF_CC))" CXX="$(strip $(HOST_CXX))"
    ifeq (%(usecflags),yes)
        %(mmake)-meson_cflags += $(HOST_CFLAGS)
    endif
    ifeq (%(usecppflags),yes)
        %(mmake)-meson_cflags += $(HOST_CPPFLAGS)
    endif
    ifeq (%(usecxxflags),yes)
        %(mmake)-meson_cxxflags += $(HOST_CXXFLAGS)
    endif
    ifeq (%(usecppflags),yes)
        %(mmake)-meson_cxxflags += $(HOST_CPPFLAGS)
    endif
    ifeq (%(usecrosstoolsdir),yes)
        %(mmake)-meson_cflags   += -I$(CROSSTOOLSDIR)/include
        %(mmake)-meson_cxxflags += -I$(CROSSTOOLSDIR)/include
        %(mmake)-meson_ldflags  := $(HOST_LDFLAGS) -L$(CROSSTOOLSDIR)/lib $(USER_LDFLAGS)
    else
        %(mmake)-meson_ldflags  := $(HOST_LDFLAGS) $(USER_LDFLAGS)
    endif
    ifeq (%(package),)
        %(mmake)-pkgdir      := $(HOSTGENDIR)/$(CURDIR)
    else
        %(mmake)-pkgdir      := $(HOSTGENDIR)/$(CURDIR)/%(package)
    endif
else
    %(mmake)-meson_opts      += --cross-file $(GENDIR)/config/conf.meson
    ifeq (%(usecflags),yes)
        %(mmake)-meson_cflags += $(CFLAGS)
    endif
    ifeq (%(usecppflags),yes)
        %(mmake)-meson_cflags += $(CPPFLAGS)
    endif
    ifeq (%(usecxxflags),yes)
        %(mmake)-meson_cxxflags += $(CXXFLAGS)
    endif
    ifeq (%(usecppflags),yes)
        %(mmake)-meson_cxxflags += $(CPPFLAGS)
    endif
    %(mmake)-meson_ldflags   := $(TARGET_ISA_LDFLAGS) $(LDFLAGS)
    ifeq (%(package),)
        %(mmake)-pkgdir      := $(GENDIR)/$(CURDIR)
    else
        %(mmake)-pkgdir      := $(GENDIR)/$(CURDIR)/%(package)
    endif
endif

%(mmake)-meson_opts += -Dc_args="$(strip $(%(mmake)-meson_cflags) %(extracppflags) %(extracflags))" \
    -Dcpp_args="$(strip $(%(mmake)-meson_cxxflags) %(extracppflags) %(extracxxflags))" \
    -Dc_link_args="$(strip $(%(mmake)-meson_ldflags) %(extraldflags))" \
    -Dcpp_link_args="$(strip $(%(mmake)-meson_ldflags) %(extraldflags))"

ifneq (%(gendir),)
    ifeq (%(package),)
        %(mmake)-pkgdir      := %(gendir)
    else
        %(mmake)-pkgdir      := %(gendir)/%(package)
    endif
endif

%(mmake)-mesonflag           ?= $(%(mmake)-pkgdir)/.meson
%(mmake)-installflag         ?= $(%(mmake)-pkgdir)/.installed

.PHONY : %(mmake) %(mmake)-clean %(mmake)-build_and_install-quick

#MM- %(mmake): setup includes core-linklibs %(mmake)-quick

#MM- %(mmake)-quick : %(mmake)-meson %(mmake)-build_and_install-quick

#MM
%(mmake)-build_and_install-quick :  $(%(mmake)-installflag)

ifeq (%(mesonbuildcmd),)
%(mmake)-mesoncmdbuild := $(MESON) compile -C $(%(mmake)-pkgdir)
else
%(mmake)-mesoncmdbuild := %(mesonbuildcmd)
endif

ifeq (%(mesoninstallcmd),)
%(mmake)-mesoncmdinstall := $(MESON) install -C $(%(mmake)-pkgdir) --no-rebuild
else
%(mmake)-mesoncmdinstall := %(mesoninstallcmd)
endif

ifeq (%(cleandir),)
%(mmake)-mesoncleandir := $(%(mmake)-pkgdir)
else
%(mmake)-mesoncleandir := %(cleandir)
endif

$(%(mmake)-installflag) : $(%(mmake)-mesonflag)
	$(%(mmake)-mesoncmdbuild)
	$(%(mmake)-mesoncmdinstall)
	$(TOUCH) $@
	$(IF) $(TEST) "%(cleanafterbuild)" = "yes"; then \
	    $(IF) ! $(MESON) compile -C $(%(mmake)-pkgdir) --clean; then \
	        $(RM) -r $(%(mmake)-mesoncleandir); \
	    fi; \
	fi

#MM
%(mmake)-meson : %(premeson) $(%(mmake)-mesonflag) %(postmeson)

# meson setup step. If the build directory was already configured, a plain
# "meson setup" would fail, so wipe and reconfigure it in that case.
$(%(mmake)-mesonflag) : TMP_SRCDIR := $(shell $(ECHO) %(srcdir) | sed 's/^\(.\):\//\/\1\//')
$(%(mmake)-mesonflag) : $(TOP)/$(CURDIR)/mmakefile
	$(Q)$(RM) $@
	%mkdirs_q $(%(mmake)-pkgdir)
	$(Q)$(ECHO) "Configuring meson build in      $(subst $(TOP)/,,$(%(mmake)-pkgdir))"
	$(Q)$(IF) $(TEST) -f $(%(mmake)-pkgdir)/meson-private/coredata.dat; then \
	    $(%(mmake)-meson-env) $(MESON) setup --wipe $(%(mmake)-meson_opts) %(extraoptions) $(%(mmake)-pkgdir) $(TMP_SRCDIR); \
	else \
	    $(%(mmake)-meson-env) $(MESON) setup $(%(mmake)-meson_opts) %(extraoptions) $(%(mmake)-pkgdir) $(TMP_SRCDIR); \
	fi && \
	$(TOUCH) $@

#MM
%(mmake)-clean :
	$(Q)$(RM) $(%(mmake)-pkgdir)
%end
#------------------------------------------------------------------------------
