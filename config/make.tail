#
#   Desc: General rules included at the end of a generated mmakefile
#

GLOB_MKDIRS := $(sort $(GLOB_MKDIRS))
ifneq ($(GLOB_MKDIRS),)
$(GLOB_MKDIRS) :
	@$(MKDIR) $@
endif

include $(SRCDIR)/tools/genmodule/Makefile.deps

# Rules for the AROS build tools
# genmodule is only ever built as a prerequisite from whichever module's
# mmakefile needs it first, so CURDIR would otherwise be inherited as that
# module's directory.
# Pin CURDIR to genmodule's own directory so it always builds in its own context.
$(GENMODULE) : $(GENMODULE_DEPS)
	@$(CALL) $(MAKE) $(MKARGS) -C $(SRCDIR)/tools/genmodule TOP=$(TOP) SRCDIR=$(SRCDIR) CURDIR=tools/genmodule $(GENMODULE)

