include $(SRCDIR)/config/aros.cfg

# Native Paula tests are grouped beneath the audio device component.
#MM- test-amiga-m68k : test-devices-audio
#MM- test-amiga-m68k-quick : test-devices-audio-quick
#MM- test-devices-audio : test-devices-audio-flush
#MM- test-devices-audio-quick : test-devices-audio-flush-quick

FILES := audio audio_hardware

OPTIMIZATION_CFLAGS := $(ROM_OPTIMIZATION_CFLAGS)

%build_module mmake=kernel-amiga-m68k-audio \
    modname=audio modtype=device \
    files="$(FILES)" uselibs="hiddstubs"
