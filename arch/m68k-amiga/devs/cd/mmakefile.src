include $(SRCDIR)/config/aros.cfg

FILES := cd cd32

# Native CD32 regressions belong to the CD device component.
#MM- test-amiga-m68k : test-devices-cd-amiga-m68k
#MM- test-amiga-m68k-quick : test-devices-cd-amiga-m68k-quick
#MM- test-devices-cd-amiga-m68k : test-devices-cdpause test-devices-cdplaytrack
#MM- test-devices-cd-amiga-m68k-quick : test-devices-cdpause-quick test-devices-cdplaytrack-quick

#USER_CPPFLAGS += -DDEBUG=1

OPTIMIZATION_CFLAGS := $(ROM_OPTIMIZATION_CFLAGS)

%build_module mmake=kernel-amiga-m68k-cd \
       modname=cd modtype=device \
       files="$(FILES)"

%common
