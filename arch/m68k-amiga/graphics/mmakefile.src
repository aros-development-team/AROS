include $(SRCDIR)/config/aros.cfg

#MM- test-graphics-amiga-m68k : test-graphics-spriteviewport
#MM- test-graphics-amiga-m68k-quick : test-graphics-spriteviewport-quick

CFILES  := bltclear changeextspritea movesprite setchiprev vbeampos
AFILES  := attemptlocklayerrom locklayerrom unlocklayerrom waitblit

#MM kernel-graphics-amiga-m68k : kernel-hidd-includes kernel-graphics-includes includes-asm_h kernel-hidd-graphics-includes
#MM kernel-graphics-amiga-m68k-linklib : kernel-amiga-m68k-amigavideo-includes

USER_INCLUDES := -I$(SRCDIR)/arch/$(CPU)-$(ARCH)/graphics \
               -I$(SRCDIR)/rom/graphics
USER_CPPFLAGS := -D__OOP_NOMETHODBASES__ \
                 -D__OOP_RELLIBBASE__ \
                 -D__UTILITY_RELLIBBASE__ \
                 -DDoRegisterCalls
USER_AFLAGS := -I$(GENINCDIR)
TARGET_ISA_AFLAGS := $(ISA_MC68060_FLAGS)

%build_archspecific \
  mainmmake=kernel-graphics maindir=rom/graphics arch=amiga-m68k \
  files="$(CFILES)" asmfiles="$(AFILES)" \
  modname=graphics

%common
