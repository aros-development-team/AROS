
include $(SRCDIR)/config/aros.cfg

CFILES          := \
        cpu_init platform_init

# The sbi platform invokes the native RISC-V code (riscv-native) from
# its own targets, as the pc target invokes all-native; they are on
# the sbi ARCH, so every sbi CPU builds it.
#MM- kernel-exec-sbi : kernel-exec-native-riscv
#MM- kernel-exec-sbi-quick : kernel-exec-native-riscv-quick
#MM- kernel-exec-sbi-linklib : kernel-exec-native-riscv-linklib
#MM- kernel-exec-sbi-set-archincludes : kernel-exec-native-riscv-set-archincludes

%set_archincludes mainmmake=kernel-exec maindir=rom/exec \
  modname=exec pri=2 arch=sbi-riscv64 \
  includes="-I$(SRCDIR)/$(CURDIR)"

%get_archincludes modname=kernel \
    includeflag=TARGET_KERNEL_INCLUDES maindir=rom/kernel

%get_archincludes modname=exec \
    includeflag=TARGET_EXEC_INCLUDES maindir=rom/exec

PRIV_EXEC_INCLUDES = \
    $(TARGET_EXEC_INCLUDES) \
    -I$(SRCDIR)/rom/exec \
    $(TARGET_KERNEL_INCLUDES) \
    -I$(SRCDIR)/rom/kernel

USER_INCLUDES     := $(PRIV_EXEC_INCLUDES)
USER_AFLAGS     := $(PRIV_EXEC_INCLUDES) -I$(GENINCDIR)

%build_archspecific \
  mainmmake=kernel-exec maindir=rom/exec arch=sbi-riscv64 \
  files=$(CFILES) modname=exec

%common
