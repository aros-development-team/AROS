
include $(SRCDIR)/config/aros.cfg

#MM kernel-hidd-vcgfx : kernel-hidd-gfx-includes

FILES	:=	\
	vcgfx_init \
	vcgfx_hiddclass \
	vcgfx_displayclass \
	vcgfx_support \
	vcgfx_bitmapclass

USER_CPPFLAGS := \
               -D__OOP_NOATTRBASES__

%build_module mmake=kernel-hidd-vcgfx \
  modname=vcgfx modtype=hidd \
  files=$(FILES)
