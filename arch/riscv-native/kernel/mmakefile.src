
include $(SRCDIR)/config/aros.cfg

#
# Native RISC-V kernel code shared by the platforms:
# the context switch, per-hart TLS, CPU numbering and masks, spinlocks,
# the SMP scheduler, IPIs and secondary hart bring-up. Firmware-specific
# operations are reached through __riscv_arosintern (kernel_riscv.h),
# which the platform fills in.
#
# Keyed by its role (native-riscv), not by a platform: each platform
# invokes it from its own kernel and exec targets
# (riscv64-sbi/{kernel,exec}).
# The include priority sorts it after the platform directory (10) and
# before riscv-all (5): the flag files are concatenated in lexical order.
#
# Every file is built for both variants; the SMP bodies are guarded by
# __AROSEXEC_SMP__.
#

CFILES := \
        kernel_riscv \
        kernel_cpu \
        kernel_scheduler \
        kernel_ipi \
        kernel_cpusmp \
        kernel_execsmp \
        platform_post \
        issuper \
        getcpucount \
        getcpunumber \
        alloccpumask \
        freecpumask \
        clearcpumask \
        getcpumask \
        cpuinmask \
        schedulecpu

%set_archincludes mainmmake=kernel-kernel maindir=rom/kernel \
  modname=kernel pri=4 arch=native-riscv \
  includes="-I$(SRCDIR)/$(CURDIR)"

%get_archincludes modname=kernel \
    includeflag=TARGET_KERNEL_INCLUDES maindir=rom/kernel

%get_archincludes modname=exec \
    includeflag=TARGET_EXEC_INCLUDES maindir=rom/exec

PRIV_KERNEL_INCLUDES = \
    $(TARGET_KERNEL_INCLUDES) \
	-I$(SRCDIR)/rom/kernel \
	$(TARGET_EXEC_INCLUDES) \
	-I$(SRCDIR)/rom/exec

USER_INCLUDES := $(PRIV_KERNEL_INCLUDES) -I$(GENINCDIR)
USER_CPPFLAGS := -D__AROS_EXEC_LIBRARY__

%build_archspecific \
  mainmmake=kernel-kernel modname=kernel maindir=rom/kernel arch=native-riscv \
  files="$(CFILES)" compiler=kernel

%common
