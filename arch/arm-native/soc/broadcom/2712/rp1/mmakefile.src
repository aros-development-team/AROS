#   AROS metamakefile for RP1 Southbridge & USB Resources
include $(SRCDIR)/config/aros.cfg

USER_LDFLAGS := -static

#MM- kernel-rp1-bcm2712 : kernel-rp1-bcm2712-resource kernel-rp1usb-bcm2712-resource

%build_module mmake=kernel-rp1-bcm2712-resource \
    modname=rp1 modtype=resource \
    files="rp1_init"

%build_module mmake=kernel-rp1usb-bcm2712-resource \
    modname=rp1usb modtype=resource \
    files="rp1_usb"

%common
