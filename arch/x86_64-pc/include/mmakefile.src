
include $(SRCDIR)/config/aros.cfg

#
# The pc headers themselves live in arch/all-pc/include, which serves both
# x86_64 and i386 and so registers them under the single target
# compiler-includes-pc. That target is only reached from here and from
# arch/i386-pc/include, because compiler/include asks for
# includes-copy-$(ARCH)-$(CPU) - which resolves to exactly one of the two.
#
# Without that, the copy would run in every build regardless of target:
# mmake generates a mmakefile for every arch directory whatever is being
# built, so aros/irqtypes.h - installed unnamespaced, and present in both
# arch/all-pc and arch/riscv64-opensbi - would be copied over the same
# $(AROS_INCLUDES)/aros/irqtypes.h by whichever ran last.
#
#MM- includes-copy-pc-x86_64 : compiler-includes-pc
