
include $(SRCDIR)/config/aros.cfg

%set_archincludes mainmmake=kernel-kernel maindir=rom/kernel \
  modname=kernel pri=10 arch=opensbi-riscv64 \
  includes="-I$(SRCDIR)/$(CURDIR)"

%get_archincludes modname=kernel \
    includeflag=TARGET_KERNEL_INCLUDES maindir=rom/kernel

%get_archincludes modname=exec \
    includeflag=TARGET_EXEC_INCLUDES maindir=rom/exec

PRIV_KERNEL_INCLUDES = \
    $(TARGET_KERNEL_INCLUDES) \
	-I$(SRCDIR)/rom/kernel \
	$(TARGET_EXEC_INCLUDES) \
	-I$(SRCDIR)/rom/exec

CFILES := \
        _displayalert \
        kernel_startup \
        kernel_console \
        kernel_debug \
        kernel_traps \
        kernel_fdt \
        kernel_acpi \
        kernel_plic \
        intr \
        kernel_timer \
        kernel_mmu \
        kernel_cpu \
        kernel_elf \
        maygetchar \
        mapglobal \
        unmapglobal \
        efi_stub

PLATFILES :=

AFILES := \
        startup \
        traps

# The kickstart holds only the components that must exist before
# anything can be loaded: kernel.resource, exec.library and
# task.resource. Everything else - including utility.library, which
# task.resource opens during its coldstart init - ships in the BSP
# package (see ../boot), loaded and relocated at boot by kernel_elf.c
# before the resident scan runs.
BSP_RES  := kernel task
BSP_LIBS := exec

BSP_KOBJS := \
    $(addprefix $(KOBJSDIR)/, $(addsuffix _resource.o, $(BSP_RES))) \
    $(addprefix $(KOBJSDIR)/, $(addsuffix _library.o, $(BSP_LIBS)))

#MM kernel-opensbi-riscv64: kernel-kernel-kobj kernel-exec-kobj kernel-task-kobj
#MM
kernel-opensbi-riscv64: $(OSGENDIR)/boot/core.elf
		$(Q)$(NOP)

#MM- kernel-opensbi-riscv64-quick: kernel-kernel-kobj-quick kernel-exec-kobj-quick kernel-task-kobj-quick kernel-opensbi-riscv64

ELFCORELIBS := -L$(AROS_LIB) -larossupport -lautoinit -llibinit -lstdc.static
ifeq ("$(AROS_TOOLCHAIN)","gnu")
ELFCORELIBS += -L$(CROSSTOOLSDIR)/lib/gcc/$(AROS_TARGET_CPU)-aros/$(TARGET_GCC_VER) -lgcc
endif

kernel-opensbi-riscv64: $(OSGENDIR)/boot/Image

$(OSGENDIR)/boot/core.elf: $(BSP_KOBJS) $(SRCDIR)/$(CURDIR)/ldscript.lds
		@$(ECHO) "Creating   $@"
		%mkdirs_q $(OSGENDIR)/boot
		@$(KERNEL_LD) -Map $(OSGENDIR)/boot/core.map -T $(SRCDIR)/$(CURDIR)/ldscript.lds -o $@ $(filter %.o,$^) $(ELFCORELIBS)
		@$(TARGET_STRIP) --strip-unneeded -R .note -R .comment $@

# Flat image carrying the RISC-V boot header (see startup.S), for
# loaders that expect a Linux-style Image - U-Boot "booti", UEFI, and
# the qemu -kernel shorthand.
$(OSGENDIR)/boot/Image: $(OSGENDIR)/boot/core.elf
		@$(ECHO) "Creating   $@"
		@$(TARGET_OBJCOPY) -O binary $< $@

#MM kernel-kernel-opensbi-riscv64 : includes

USER_INCLUDES := $(PRIV_KERNEL_INCLUDES) -I$(GENINCDIR) -I$(AROS_DEVELOPER)/include

%build_archspecific \
  mainmmake=kernel-kernel modname=kernel maindir=rom/kernel arch=opensbi-riscv64 \
  files="$(CFILES) $(PLATFILES)" asmfiles="$(AFILES)" compiler=kernel

%common
