#

include $(SRCDIR)/config/aros.cfg

USER_CPPFLAGS := \
    -D__KERNEL_NOLIBBASE__ \
    -D__UTILITY_NOLIBBASE__ \
    -D__DEBUG_NOLIBBASE__ \
    -DNO_INLINE_STDARG

USER_INCLUDES := \
    -I$(SRCDIR)/$(CURDIR) \
    -I$(SRCDIR)/rom/debug

FUNCS := debug_platform disassemble

%build_archspecific \
  mainmmake=kernel-debug maindir=rom/debug \
  arch=riscv64 modname=debug \
  cppflags="$(CPPFLAGS) $(USER_CPPFLAGS) $(USER_INCLUDES)" \
  files=" $(FUNCS)"

%build_archspecific \
  mainmmake=kernel-debug maindir=rom/debug \
  arch=riscv modname=debug \
  cppflags="$(CPPFLAGS) $(USER_CPPFLAGS) $(USER_INCLUDES)" \
  files=" $(FUNCS)"

%common
