
include $(SRCDIR)/config/aros.cfg

#MM kernel-bootstrap-pc-i386: linklibs-bootconsole linklibs-bootstrap

MAINDIR := arch/all-pc/bootstrap

USER_INCLUDES := -I $(SRCDIR)/$(MAINDIR) -isystem $(SRCDIR)/bootstrap/include \
                 -I$(GENDIR)/include

%build_archspecific \
	mainmmake=kernel-bootstrap-pc maindir=$(MAINDIR) arch=i386 \
	files=cpu compiler=kernel

%common
