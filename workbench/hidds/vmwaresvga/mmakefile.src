
include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/workbench/libs/mesa/mesa.cfg

GALLIUM_PATH = $(top_srcdir)/src/gallium

include $(SRCDIR)/$(CURDIR)/sources.drm.mak

# WARNING - THIS MMAKEFILE REFERENCES SOURCE CODE OUTSIDE OF ITS TREE
# (Mesa's svga gallium driver, from the mesa port)
#
# The 3D side is Mesa's own svga gallium driver, driven through its stock
# drm winsys and an in-process libdrm shim by a port of the Linux vmwgfx
# kernel driver, in the way nouveau.hidd is built. The DRM core, TTM and
# the Linux compatibility layer are the same base the nouveau hidd carries,
# as a copy of its own in this tree.

ifneq ($(wildcard $(GALLIUM_PATH)/drivers/svga/Makefile.sources),)
include $(GALLIUM_PATH)/drivers/svga/Makefile.sources
else
# Mesa >= 26 ships no Makefile.sources; this mirrors files_svga in meson.build.
C_SOURCES := \
             svga_cmd.c svga_cmd_vgpu10.c svga_context.c \
             svga_draw_arrays.c svga_draw.c svga_draw_elements.c \
             svga_format.c svga_image_view.c svga_link.c \
             svga_pipe_blend.c svga_pipe_blit.c svga_pipe_clear.c \
             svga_pipe_constants.c svga_pipe_cs.c svga_pipe_depthstencil.c \
             svga_pipe_draw.c svga_pipe_flush.c svga_pipe_fs.c svga_pipe_gs.c \
             svga_pipe_ts.c svga_pipe_misc.c svga_pipe_query.c \
             svga_pipe_rasterizer.c svga_pipe_sampler.c svga_pipe_streamout.c \
             svga_pipe_vertex.c svga_pipe_vs.c \
             svga_resource_buffer.c svga_resource_buffer_upload.c \
             svga_resource.c svga_resource_texture.c svga_sampler_view.c \
             svga_screen.c svga_screen_cache.c svga_shader.c svga_shader_buffer.c \
             svga_state.c svga_state_constants.c svga_state_cs.c \
             svga_state_framebuffer.c svga_state_fs.c svga_state_gs.c \
             svga_state_ts.c svga_state_need_swtnl.c svga_state_rss.c \
             svga_state_sampler.c svga_state_tgsi_transform.c svga_state_tss.c \
             svga_state_uav.c svga_state_vdecl.c svga_state_vs.c \
             svga_surface.c svga_swtnl_backend.c svga_swtnl_draw.c \
             svga_swtnl_state.c svga_tgsi.c svga_tgsi_decl_sm30.c \
             svga_tgsi_insn.c svga_tgsi_vgpu10.c \
             svgadump/svga_dump.c svgadump/svga_shader_dump.c \
             svgadump/svga_shader_op.c
endif

# The svga glue targets the Mesa 26 gallium driver API; only hook the hidd
# in for the Mesa version it has been ported to.
#MM- workbench-hidds-vmwaresvga : hidd-vmwaresvga-mesa$(OPT_MESAGL)
#MM- hidd-vmwaresvga-mesa26.0.0 : hidd-vmwaresvga-$(AROS_TARGET_ARCH)-$(AROS_TARGET_CPU)
#MM- hidd-vmwaresvga-pc-i386 : hidd-vmwaresvga
#MM- hidd-vmwaresvga-pc-x86_64 : hidd-vmwaresvga
#MM hidd-vmwaresvga: includes hidd-vmwaresvga-drmcore hidd-vmwaresvga-drm hidd-vmwaresvga-libdrm hidd-vmwaresvga-svga hidd-gallium mesa3dgl-linklibs linklibs-libatomic workbench-libs-z-linklib
#MM hidd-vmwaresvga-svga : mesa3dgl-linklibs
#MM hidd-vmwaresvga-libdrm : mesa3dgl-linklibs

###############################################
# Mesa's svga gallium driver -> libgallium_svga.a
###############################################

MESA3D_VMWARESVGA_C_SOURCES := $(filter %.c,$(C_SOURCES))

GALLIUM_SVGA_SOURCES := \
	$(addprefix $(GALLIUM_PATH)/drivers/svga/,$(MESA3D_VMWARESVGA_C_SOURCES:.c=))

MESA_INCLUDES := \
            -I$(top_srcdir)/include \
            -I$(top_srcdir)/include/GL \
            -I$(top_srcdir)/src \
            -iquote $(GALLIUM_PATH)/drivers/svga/include \
            -iquote $(GALLIUM_PATH)/drivers/svga \
            -iquote $(GALLIUM_PATH)/drivers \
            -iquote $(GALLIUM_PATH)/include \
            -iquote $(GALLIUM_PATH)/auxiliary \
            -iquote $(GENDIR)/workbench/libs/mesa/$(MESAGLVERSION)/src/mesa/main \
            -iquote $(top_builddir)/src \
            -iquote $(top_builddir)/src/compiler \
            -iquote $(top_builddir)/src/compiler/glsl \
            -iquote $(top_builddir)/src/compiler/nir \
            -iquote $(top_builddir)/src/util \
            -iquote $(top_builddir)/src/util/format \
            -iquote $(top_srcdir)/src/compiler \
            -iquote $(top_srcdir)/src/compiler/nir \
            -iquote $(GENDIR)/workbench/libs/mesa/src/compiler/nir

NOWARN_FLAGS := $(NOWARN_UNUSED_VALUE) $(NOWARN_UNUSED_VARIABLE) $(NOWARN_STRICT_ALIASING)
USER_CFLAGS := $(MESA_STD) $(MESA_COMPILEOPTIONS) $(CFLAGS_NO_STRICT_ALIASING) $(NOWARN_FLAGS)
USER_INCLUDES := $(MESA_INCLUDES)
USER_CPPFLAGS := $(MESA_COMPILEFLAGS) $(MESA_DEBUG) \
                -DPACKAGE_VERSION=\"$(MESAGLVERSION)\" \
                -DEMBEDDED_DEVICE \
                -DGALLIUM_VMWGFX

%build_linklib mmake=hidd-vmwaresvga-svga libname=gallium_svga objdir=$(GENDIR)/$(CURDIR)/$(MESAGLVERSION)/gallium \
    files="$(GALLIUM_SVGA_SOURCES)"

###############################################
# libdrm shim + Mesa's svga drm winsys -> libdrm_vmwgfx.a
###############################################

# The libdrm shim reaches into the DRM core; the winsys is Mesa code,
# compiled from the port tree, and sees the Mesa tree (util/, pipebuffer/)
# the way the svga driver does.
USER_INCLUDES := \
            -I$(SRCDIR)/$(CURDIR)/include \
            $(MESA_INCLUDES) \
            -iquote $(GALLIUM_PATH)/winsys/svga/drm \
            -I$(SRCDIR)/$(CURDIR)/include/uapi \
            -I$(SRCDIR)/$(CURDIR)/include/uapi/drm \
            -I$(SRCDIR)/$(CURDIR)/drm \

%build_linklib mmake=hidd-vmwaresvga-libdrm libname=drm_vmwgfx objdir=$(GENDIR)/$(CURDIR)/$(MESAGLVERSION)/libdrm \
    files="$(AROS_VMWGFX_LIBDRM_SOURCES) $(addprefix $(GALLIUM_PATH)/winsys/svga/drm/,$(AROS_VMWGFX_WINSYS_SOURCES))"

###############################################
# DRM core, TTM, linux compat -> libdrm_vmwgfx_core.a
###############################################

DRM_INCLUDES := \
            -I$(SRCDIR)/$(CURDIR)/include \
            -I$(SRCDIR)/$(CURDIR)/include/uapi \
            -I$(SRCDIR)/$(CURDIR)/include/uapi/drm \
            -I$(SRCDIR)/$(CURDIR)/drm \

# The driver and Mesa's winsys both name a fence constructor vmw_fence_create;
# in one binary the driver's is called by its module's name.
DRM_CPPFLAGS := -D__KERNEL__ -DCONFIG_X86 -DDRM_COMPAT_NAME=\"vmwgfx\" -Dvmw_fence_create=vmwgfx_fence_create
DRM_NOWARN_FLAGS := $(NOWARN_UNINITIALIZED) $(NOWARN_STRICT_ALIASING) $(NOWARN_UNUSED_BUT_SET_VARIABLE) $(NOWARN_UNUSED_VARIABLE) $(NOWARN_UNUSED_FUNCTION) $(NOWARN_MISSING_BRACES)

USER_INCLUDES := $(DRM_INCLUDES)
USER_CPPFLAGS := $(DRM_CPPFLAGS)
USER_CFLAGS := $(DRM_NOWARN_FLAGS) $(CFLAGS_GNU11) -fno-strict-aliasing

%build_linklib mmake=hidd-vmwaresvga-drmcore libname=drm_vmwgfx_core objdir=$(GENDIR)/$(CURDIR)/drmcore \
    files="$(AROS_VMWGFX_DRMCORE_SOURCES)" srcdir="$(SRCDIR)/$(CURDIR)" usetree=yes

###############################################
# vmwgfx driver + AROS glue -> libdrm_vmwgfx_drv.a
###############################################

USER_INCLUDES := \
            $(DRM_INCLUDES) \
            -I$(SRCDIR)/$(CURDIR)/include/uapi \
            -iquote $(SRCDIR)/$(CURDIR)/drm/vmwgfx \
            -iquote $(SRCDIR)/$(CURDIR)/drm/vmwgfx/device_include \

USER_CPPFLAGS := $(DRM_CPPFLAGS)
USER_CFLAGS := $(DRM_NOWARN_FLAGS) $(CFLAGS_GNU11) -fno-strict-aliasing

%build_linklib mmake=hidd-vmwaresvga-drm libname=drm_vmwgfx_drv objdir=$(GENDIR)/$(CURDIR)/drm \
    files="$(AROS_VMWGFX_DRM_SOURCES)" srcdir="$(SRCDIR)/$(CURDIR)" usetree=yes

#################################################
# hidd classes -> vmwaresvga.hidd
#################################################

FILES	:=	\
	vmwaresvga_init \
	vmwaresvga_hiddclass \
	vmwaresvga_displayclass \
	vmwaresvga_kms \
	vmwaresvga_offbitmapclass \
	vmwaresvga_onbitmapclass \
	vmwaresvga_galliumclass \
	$(SRCDIR)/workbench/libs/mesa/emul_arosc \
	vmwaresvga_util

USER_INCLUDES := \
            -I$(SRCDIR)/$(CURDIR)/include \
            $(MESA_INCLUDES) \
            -iquote $(GALLIUM_PATH)/winsys/svga/drm \
            -I$(SRCDIR)/$(CURDIR)/include/uapi \
            -I$(SRCDIR)/$(CURDIR)/include/uapi/drm \

USER_CPPFLAGS := $(MESA_COMPILEFLAGS) $(MESA_DEBUG) \
                -DPACKAGE_VERSION=\"$(MESAGLVERSION)\" \
                -DEMBEDDED_DEVICE \
                -DGALLIUM_VMWGFX
USER_CFLAGS := $(MESA_STD) $(MESA_COMPILEOPTIONS) $(CFLAGS_NO_STRICT_ALIASING) $(NOWARN_FLAGS)

# The svga driver goes through NIR, so the (C++) compiler linklib is part
# of the group and the module is linked with the C++ driver.
USER_LDFLAGS := \
  -L$(top_libdir) -L$(AROS_LIB) \
  -Wl,--start-group -lgallium_svga -ldrm_vmwgfx -ldrm_vmwgfx_drv -ldrm_vmwgfx_core \
  -lcompiler -lgalliumauxiliary -lmesautil \
  -loop -lhiddstubs -lz -lpthread -lposixc -lstdc
ifneq ($(TARGET_LIBATOMIC),)
USER_LDFLAGS += $(TARGET_CXX_LIBS)
endif
USER_LDFLAGS += -Wl,--end-group

%build_module mmake=hidd-vmwaresvga \
  modname=vmwaresvga modtype=hidd \
  files=$(FILES) alwayscxxlink=yes \
  uselibs="" objdir="$(OBJDIR)/$(MESAGLVERSION)"

%common
