include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/workbench/libs/mesa/mesa.cfg

ifeq ($(OPT_LLVM),)
ifneq ($(TARGET_LLVM_VER),)
OPT_LLVM := $(TARGET_LLVM_VER)
else
OPT_LLVM := 11.0.0
endif
endif
LLVM_VERSION_MAJOR := $(word 1,$(subst ., ,$(OPT_LLVM)))
LLVM_VERSION_MINOR := $(word 2,$(subst ., ,$(OPT_LLVM)))
LLVM_VERSION_HEX := 0x$(shell printf "%02x%02x" $(LLVM_VERSION_MAJOR) $(LLVM_VERSION_MINOR))

# The target-side LLVM archives, by path: as -l names they would be looked
# up through every -L in order, and TARGET_CXX_LDFLAGS puts the crosstools
# lib directory first, which holds the host's own libLLVM*.a when the AROS
# toolchain was built with LLVM.
LLVM_LIBS := $(wildcard $(AROS_DEVELOPER)/lib/libLLVM*.a)

# lavapipe, the Vulkan WSI and the Vulkan runtime fill their entrypoint
# tables through weak references, which pull nothing out of an archive on
# their own: link them whole, as Mesa's lavapipe target does.
USER_LDFLAGS := $(TARGET_CXX_LDFLAGS) \
            -L$(top_libdir) \
            -L$(AROS_DEVELOPER)/lib \
            -Wl,--start-group \
            -Wl,--whole-archive \
            -llavapipe \
            -lvulkan_wsi \
            -lvulkan_runtime \
            -lgalliumvm \
            -Wl,--no-whole-archive \
            -lllvmpipe \
            -lcompiler \
            -lgalliumdrawllvm \
            -lgalliumtess \
            -lgalliumauxiliary \
            -lmesautil \
            $(LLVM_LIBS) \
            -lz \
            -lpthread \
            -lposixc_rel \
            -lstdc_rel
ifneq ($(TARGET_LIBATOMIC),)
USER_LDFLAGS += $(TARGET_CXX_LIBS)
endif
USER_LDFLAGS += -Wl,--end-group

# emul_arosc supplies the exec based malloc/free the other Mesa modules
# use, so allocations may cross the module boundary.
LAVAPIPE_HIDD_FILES := \
            lavapipe_init \
            lavapipe_vulkanclass \
            lavapipe_sw \
            lavapipe_llvm_rtti \
            $(SRCDIR)/workbench/libs/mesa/emul_arosc

# lavapipe sits on llvmpipe, which needs the target-side LLVM libraries;
# those only exist with the llvm toolchain family.
#MM- workbench-hidds : hidd-lavapipe-$(AROS_TOOLCHAIN)-$(AROS_TARGET_TOOLCHAIN)
#MM- hidd-lavapipe-llvm-yes : hidd-lavapipe

#MM hidd-lavapipe : includes hidd-vulkan mesa3dgl-linklibs linklibs-libatomic \
#MM     mesa3d-linklib-lavapipe mesa3d-linklib-vulkan-runtime mesa3d-linklib-vulkan-wsi \
#MM     mesa3d-linklib-llvmpipe mesa3d-linklib-galliumdrawllvm mesa3d-linklib-galliumtess

VK_RT_GENDIR := $(top_builddir)/src/vulkan/runtime
VK_UTIL_GENDIR := $(top_builddir)/src/vulkan/util

USER_INCLUDES += \
            -iquote $(SRCDIR)/$(CURDIR) \
            -iquote $(top_srcdir)/src/gallium/include \
            -iquote $(top_srcdir)/src/gallium/auxiliary \
            -iquote $(top_srcdir)/src/gallium/drivers \
            -iquote $(top_srcdir)/src \
            -iquote $(top_srcdir)/src/util \
            -iquote $(top_srcdir)/src/compiler \
            -iquote $(top_srcdir)/src/compiler/nir \
            -iquote $(top_srcdir)/src/vulkan/runtime \
            -iquote $(top_srcdir)/src/vulkan/util \
            -iquote $(top_srcdir)/include \
            -iquote $(top_builddir)/src \
            -iquote $(top_builddir)/src/compiler \
            -iquote $(top_builddir)/src/compiler/nir \
            -iquote $(top_builddir)/src/util \
            -iquote $(top_builddir)/src/util/format \
            -iquote $(VK_RT_GENDIR) \
            -iquote $(VK_UTIL_GENDIR) \
            -I$(top_srcdir)/src/gallium/include \
            -I$(VK_RT_GENDIR) \
            -I$(VK_UTIL_GENDIR)

USER_CPPFLAGS += -DGALLIUM_LLVMPIPE -DDRAW_LLVM_AVAILABLE=1 -DLLVM_AVAILABLE \
                 -DHAVE_LLVM=$(LLVM_VERSION_HEX) \
                 -DMESA_LLVM_VERSION_STRING=\"$(OPT_LLVM)\" \
                 -DPACKAGE_VERSION=\"$(MESAGLVERSION)\"

%build_module mmake=hidd-lavapipe modname=lavapipe modtype=hidd \
   files="$(LAVAPIPE_HIDD_FILES)" alwayscxxlink=yes uselibs=""

%common
