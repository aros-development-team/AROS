Changes to the Linux 6.18 amdgpu sources carried in this tree.

Not carried, being GPL-only:
  drivers/gpu/drm/amd/amdgpu/amdgpu_vkms.c       (GPL-2.0+, removed)
  drivers/gpu/drm/amd/amdgpu/amdgpu_vkms.h       (GPL-2.0+, replaced by an AROS header)
  drivers/gpu/drm/amd/amdgpu/amdgpu_atpx_handler.c (GPL-2.0-only, removed)

--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -3162,6 +3162,22 @@
 	NULL,
 };
 
+#ifdef __AROS__
+int amdgpu_aros_probe(struct pci_dev *pdev)
+{
+	const struct pci_device_id *ent = pci_match_id(pciidlist, pdev);
+
+	if (!ent)
+		return -ENODEV;
+	return amdgpu_pci_probe(pdev, ent);
+}
+
+void amdgpu_aros_remove(struct pci_dev *pdev)
+{
+	amdgpu_pci_remove(pdev);
+}
+#endif
+
 static struct pci_driver amdgpu_kms_pci_driver = {
 	.name = DRIVER_NAME,
 	.id_table = pciidlist,
