+    LONG srcX, LONG srcY, LONG destX, LONG destY, LONG width, LONG height,
+    ULONG drawmode)
+{
+	/* acceleration setup can fail and leave the channel torn down;
+	 * report the blit as not accelerated rather than dereference it */
