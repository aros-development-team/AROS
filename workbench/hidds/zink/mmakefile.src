
include $(SRCDIR)/config/aros.cfg
include $(SRCDIR)/workbench/libs/mesa/mesa.cfg

GALLIUM_PATH = $(top_srcdir)/src/gallium

# Generated zink and Vulkan runtime headers
ZINK_GENDIR := $(top_builddir)/src/gallium/drivers/zink
VK_RT_GENDIR := $(top_builddir)/src/vulkan/runtime
VK_UTIL_GENDIR := $(top_builddir)/src/vulkan/util

#MM- workbench-hidds : hidd-zink-$(AROS_TARGET_TOOLCHAIN)
#MM- hidd-zink-yes : hidd-zink

#MM hidd-zink : includes hidd-gallium hidd-vulkan mesa3dgl-linklibs linklibs-libatomic mesa3d-linklib-zink mesa3d-linklib-vulkan-runtime

# emul_arosc supplies the exec based malloc/free that mesa3dgl.library also
# uses; NIR shaders cross the module boundary and must share one allocator.
ZINK_HIDD_SOURCES := \
            zink_init \
            zink_galliumclass \
            $(SRCDIR)/workbench/libs/mesa/emul_arosc

USER_INCLUDES := \
            $(USER_INCLUDES) \
            -iquote $(GALLIUM_PATH)/drivers \
            -iquote $(GALLIUM_PATH)/include \
            -iquote $(GALLIUM_PATH)/auxiliary \
            -iquote $(SRCDIR)/$(CURDIR) \
            -iquote $(top_srcdir)/src \
            -iquote $(top_srcdir)/src/compiler \
            -iquote $(top_srcdir)/src/compiler/nir \
            -iquote $(top_builddir)/src \
            -iquote $(top_builddir)/src/compiler \
            -iquote $(top_builddir)/src/compiler/nir \
            -iquote $(top_builddir)/src/util \
            -iquote $(top_builddir)/src/util/format

NOWARN_CFLAGS := $(NOWARN_MAYBE_UNINITIALIZED)
USER_CFLAGS += $(NOWARN_CFLAGS)
USER_CPPFLAGS += -D__AROS__
#USER_CPPFLAGS += -DDEBUG=1

USER_LDFLAGS := $(TARGET_CXX_LDFLAGS) \
  -L$(top_libdir) \
   -Wl,--start-group -lzink -lvulkan_runtime -lcompiler -lgalliumauxiliary -lmesautil \
  -lz -lpthread -lposixc_rel -lstdc_rel
ifneq ($(TARGET_LIBATOMIC),)
USER_LDFLAGS += $(TARGET_CXX_LIBS)
endif
USER_LDFLAGS += -Wl,--end-group

%build_module mmake=hidd-zink modname=zink modtype=hidd \
    files="$(ZINK_HIDD_SOURCES)" alwayscxxlink=yes uselibs="" objdir="$(OBJDIR)/$(MESAGLVERSION)"

%common
