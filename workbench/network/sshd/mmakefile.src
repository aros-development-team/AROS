include $(SRCDIR)/config/aros.cfg

LIBSSH_INCDIR := $(PORTSDIR)/libssh/libssh-0.12.0/include

# libssh and the mbedTLS linklibs are installed into the standard lib tree
# (uselibs below); mbedTLS headers likewise come from the standard include
# tree, installed by workbench-libs-mbedtls (no version-pinned Ports path
# to go stale).  The libraries are built with the AROS mbedTLS
# configuration; compile against the same config so structure layouts
# match.
USER_INCLUDES := -I$(LIBSSH_INCDIR) -I$(SRCDIR)/workbench/libs/mbedtls
USER_CPPFLAGS := -DMBEDTLS_CONFIG_FILE='"mbedtls_aros_config.h"'
# gnu99: strict c99 removes the 'asm' keyword the inline LVO headers need
USER_CFLAGS := $(CFLAGS_GNU99)

#MM- workbench-network-sshd : workbench-libs-libssh workbench-libs-mbedtls \
#MM  network-includes-copy arostcp-linklibs-netlib

# The sshd daemon installs alongside the other managed network services
# (matching dhcpd); the ssh/ssh-keygen client tools stay in C:.
# netlib provides SocketBase (+ auto-open) for libssh's bsdsocket bindings.
%build_prog mmake=workbench-network-sshd \
    progname=sshd targetdir=$(AROS_SYSTEM)/Network/Services \
    files="sshd" uselibs="ssh mbedtls mbedx509 mbedcrypto net"

#MM workbench-network-ssh : workbench-libs-libssh workbench-libs-mbedtls \
#MM  network-includes-copy arostcp-linklibs-netlib
%build_prog mmake=workbench-network-ssh \
    progname=ssh targetdir=$(AROS_C) \
    files="ssh" uselibs="ssh mbedtls mbedx509 mbedcrypto net"

#MM workbench-network-ssh-keygen : workbench-libs-libssh workbench-libs-mbedtls \
#MM  network-includes-copy arostcp-linklibs-netlib
%build_prog mmake=workbench-network-ssh-keygen \
    progname=ssh-keygen targetdir=$(AROS_C) \
    files="ssh-keygen" uselibs="ssh mbedtls mbedx509 mbedcrypto net"

%common
