
include $(SRCDIR)/config/aros.cfg

# RTP-MIDI (RFC 6295) and the AppleMIDI session protocol around it, as a
# link library. The payload: the command section, the recovery journal, a
# sender's and a receiver's state, and the timing of delivery. The
# sessions: invitations, the table of peers, which port of a driver a peer
# is given, the clock exchange. Portable C that calls nothing of the
# system: whoever links it owns the sockets and the clock.

FILES := rtpmidi sender receiver timing \
         applemidi session peers ports clock

USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)/include

#MM linklibs-rtpmidi : includes

%build_linklib mmake=linklibs-rtpmidi \
    libname=rtpmidi \
    files="$(FILES)"

%common
