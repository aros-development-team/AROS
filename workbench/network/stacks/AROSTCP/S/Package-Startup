Path "C" "S" ADD QUIET

; Nothing populates ENVARC:AROSTCP on a fresh install, and a Live CD cannot
; write ENVARC: at all, so without this the stack never starts and the system
; boots with no network. Only runs when nothing is configured.
If NOT EXISTS ENV:AROSTCP/Config
  Execute S/netautoconf
EndIf

Protect S/startnet s add quiet
Protect S/stopnet s add quiet

if ${AROSTCP/AutoRun} eq "True"

  if ${AROSTCP/WirelessAutoRun} eq "True"
    Run >NIL: QUIET C:WirelessManager ${AROSTCP/WirelessDevice} NOGUI
  EndIf

  if ${AROSTCP/MobileAutorun} eq "True"
    Run >NIL: QUIET C:ModemManager
  EndIf

  C:Execute S/startnet

  if EXISTS ENV:AROSTCP/ServerAutoMounts
    Mount ${AROSTCP/ServerAutoMounts} 
  EndIf
EndIf
