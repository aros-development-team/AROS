include $(SRCDIR)/config/aros.cfg

#
# Copyright (C) 2026 The AROS Dev Team
#
# This program is free software; you can redistribute it and/or modify
# it under the terms of the GNU General Public License version 2 as
# published by the Free Software Foundation.
#
#
# netconfig.atcp - the configuration readers (module
# "netconfig"): the command line and db/general.config, db/netdb and the
# files it includes, the interface lines, db/services.d. Loaded by the
# stack's task for a read - at start-up, at every reload, for an ARexx
# command that reads configuration text - and unloaded after
# (bsdsocket/kern/netconfig_ops.h). Needs no other module. Without it the
# stack does not start, unless it is built into the program.
#
# Built from the stack's sources where they are, with the stack's own
# include paths and options (stack.cfg), plus -DNETMODULE, the .conf file
# every module library shares and the shared glue file. The file list is
# $(STACK_NETCONFIG_C) of bsdsocket/conf/group-netconfig.cfg. While that
# file builds the group into the stack program (STACK_NETCONFIG_IN_CORE=yes),
# or the program is monolithic, the library is built all the same and is not
# used: a module that is part of the program is never also loaded.
#
include $(SRCDIR)/workbench/network/stacks/AROSTCP/bsdsocket/stack.cfg

#MM- workbench-network-stacks-arostcp-modules : workbench-network-stacks-arostcp-modules-netconfig
#MM workbench-network-stacks-arostcp-modules-netconfig : includes linklibs network-includes-copy

USER_INCLUDES := $(STACK_INCLUDES)
USER_CPPFLAGS := $(STACK_MODULE_CPPFLAGS)
USER_CFLAGS   := $(STACK_CFLAGS)
USER_LDFLAGS  := $(STACK_MODULE_LDFLAGS)

%build_module_library mmake=workbench-network-stacks-arostcp-modules-netconfig \
    modname=netconfig modtype=library modsuffix=$(STACK_MODULE_ATCP) \
    conffile=$(STACK_MODULE_CONF) \
    files="$(addprefix $(STACK_SRC_REL)/,$(STACK_NETCONFIG_C) $(STACK_MODULE_GLUE))" \
    moduledir=$(STACK_MODULE_DIR)

%common
