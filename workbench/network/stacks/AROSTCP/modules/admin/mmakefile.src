include $(SRCDIR)/config/aros.cfg

#
# Copyright (C) 2026 The AROS Dev Team
#
# This program is free software; you can redistribute it and/or modify
# it under the terms of the GNU General Public License version 2 as
# published by the Free Software Foundation.
#
#
# admin.atcp - administration (module "admin"): the routing
# socket (PF_ROUTE), the route, interface and name-server calls of
# bsdsocket.library and the control-panel glue. Loaded by the stack on the
# first routing socket, the first such call or when the panel is opened
# (bsdsocket/kern/admin_ops.h), or at start with MODULES=ADMIN. Needs no
# other module.
#
# Built from the stack's sources where they are, with the stack's own
# include paths and options (stack.cfg), plus -DNETMODULE, the .conf file
# every module library shares and the shared glue file. The file list is
# $(STACK_ADMIN_C) of bsdsocket/conf/group-admin.cfg. While that file
# builds the group into the stack program (STACK_ADMIN_IN_CORE=yes), or the
# program is monolithic, the library is built all the same and is not
# used: a module that is part of the program is never also loaded.
#
include $(SRCDIR)/workbench/network/stacks/AROSTCP/bsdsocket/stack.cfg

#MM- workbench-network-stacks-arostcp-modules : workbench-network-stacks-arostcp-modules-admin
#MM workbench-network-stacks-arostcp-modules-admin : includes linklibs network-includes-copy

USER_INCLUDES := $(STACK_INCLUDES)
USER_CPPFLAGS := $(STACK_MODULE_CPPFLAGS)
USER_CFLAGS   := $(STACK_CFLAGS)
USER_LDFLAGS  := $(STACK_MODULE_LDFLAGS)

%build_module_library mmake=workbench-network-stacks-arostcp-modules-admin \
    modname=admin modtype=library modsuffix=$(STACK_MODULE_ATCP) \
    conffile=$(STACK_MODULE_CONF) \
    files="$(addprefix $(STACK_SRC_REL)/,$(STACK_ADMIN_C) $(STACK_MODULE_GLUE))" \
    moduledir=$(STACK_MODULE_DIR)

%common
