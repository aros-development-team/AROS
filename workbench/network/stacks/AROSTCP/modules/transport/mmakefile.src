
include $(SRCDIR)/config/aros.cfg

#
# Copyright (C) 2026 The AROS Dev Team
#
# This program is free software; you can redistribute it and/or modify
# it under the terms of the GNU General Public License version 2 as
# published by the Free Software Foundation.
#
#
# transport.prot - TCP, UDP and the raw sockets for every address
# family, and the PCB layer (module "transport"). Loaded because a family
# needs it, never for its own sake.
#
# A module of the stack in a library file of its own (bsdsocket/net/netcore.h,
# bsdsocket/kern/net_modload.c). It is built from the stack's sources where
# they are, with the stack's own include paths and options (stack.cfg), plus
# -DNETMODULE, the .conf file every module library shares and the shared
# glue file. The file list is $(STACK_TRANSPORT_C) of stack.cfg.
#
include $(SRCDIR)/workbench/network/stacks/AROSTCP/bsdsocket/stack.cfg

#MM- workbench-network-stacks-arostcp-modules : workbench-network-stacks-arostcp-modules-transport
#MM workbench-network-stacks-arostcp-modules-transport : includes linklibs network-includes-copy

USER_INCLUDES := $(STACK_INCLUDES)
USER_CPPFLAGS := $(STACK_MODULE_CPPFLAGS)
USER_CFLAGS   := $(STACK_CFLAGS)
USER_LDFLAGS  := $(STACK_MODULE_LDFLAGS)

%build_module_library mmake=workbench-network-stacks-arostcp-modules-transport \
    modname=transport modtype=library modsuffix=$(STACK_MODULE_PROT) \
    conffile=$(STACK_MODULE_CONF) \
    files="$(addprefix $(STACK_SRC_REL)/,$(STACK_TRANSPORT_C) $(STACK_MODULE_GLUE))" \
    moduledir=$(STACK_MODULE_DIR)

%common
