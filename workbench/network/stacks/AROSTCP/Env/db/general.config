#
# AROSTCP configuration file. See documentation for usage.
#
USELOOPBACK=YES
DEBUGSANA=NO
USENS=SECOND
GATEWAY=NO
HOSTNAME=arosbox.arosnet
LOG FILTERFILE=5
GUI PANEL=MUI
OPENGUI=YES
#
# Path to the DHCP client binary.
# Relative paths are resolved from the AROSTCP root directory.
# Default: C/dhclient
#
#DHCLIENT=C/dhclient
#
# Protocol families the stack runs: a list of module names separated by
# commas. INET is IPv4, INET6 is IPv6; the transports (TCP, UDP, raw
# sockets) are started for whichever is selected. A family that is not
# selected is not started, and when it is a library file of its own
# (Libs/<name>.prot) it is not loaded.
# Default: INET,INET6
#
#PROTOCOLS=INET,INET6
#PROTOCOLS=INET
#PROTOCOLS=INET6
