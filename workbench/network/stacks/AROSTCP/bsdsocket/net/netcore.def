/*
 * What a module in a library file of its own may use of the core, one line
 * each: NC(name). A function or a variable - the line is the same.
 * (net/netcore.h makes `struct netcore' of it, kern/net_services.c the
 * core's table, tools/mkimports.py the mapping header net/netcore_map.h.)
 *
 * THE ORDER IS THE BINARY INTERFACE. Append only; never remove, move or
 * re-type a line. Raise NETCORE_VERSION (net/netcore.h) with every line
 * added, and write net/netcore_map.h again: tools/netcore-update.sh does
 * the checking, the appending and the writing.
 *
 * A comment after a line says more:
 *      NC(ifnet_list)  = ifnet
 *          the sources say `ifnet_list' (an alias in net/if.h); in the core
 *          that is the variable `ifnet', whose name is also a structure tag
 *      NC(bsd_malloc)  macro(size, type, flags) = (size)
 *          the headers wrap the function in a macro of the same name; the
 *          mapping keeps the wrapper
 */

/* version 1: what IPv4, IPv6 and the transports use today, and the demo module */
NC(ifnet_list)      /* = ifnet */
NC(mbstats)         /* = mbstat */
NC(mbconfig)        /* = mbconf */
