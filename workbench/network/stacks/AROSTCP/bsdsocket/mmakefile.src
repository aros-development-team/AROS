#
# The stack program. What it is built from, and with which options, is in
# stack.cfg, shared with the protocol libraries (../modules/*): the file
# lists of the four groups (core, transports, IPv4, IPv6), the include
# paths and the compiler options.
#
#   workbench-network-stacks-arostcp-bsdsocket
#       the program System/Network/AROSTCP/C/AROSTCP: the core alone, with
#       no protocol code (AROSTCP_MONOLITHIC=no, the default), or the core
#       and every protocol in one binary (AROSTCP_MONOLITHIC=yes, for
#       debugging; see stack.cfg).
#
# The protocols are the libraries transport.prot,
# inet.prot and inet6.prot, built by
#   workbench-network-stacks-arostcp-modules-transport
#   workbench-network-stacks-arostcp-modules-inet
#   workbench-network-stacks-arostcp-modules-inet6
# (all of them: workbench-network-stacks-arostcp-modules).
#
include $(SRCDIR)/workbench/network/stacks/AROSTCP/bsdsocket/stack.cfg

USER_INCLUDES := $(STACK_INCLUDES)
USER_CPPFLAGS := $(STACK_CPPFLAGS)
USER_CFLAGS   := $(STACK_CFLAGS)

STACK_PROGRAM_C := $(STACK_CORE_C)
ifeq ($(AROSTCP_MONOLITHIC),yes)
STACK_PROGRAM_C += $(STACK_PROTOCOL_C)
endif

%build_prog mmake=workbench-network-stacks-arostcp-bsdsocket \
    progname=$(STACK_NAME) \
    files="$(STACK_PROGRAM_C)" \
    targetdir=$(AROS_SYSTEM)/Network/$(STACK_NAME)/C

%common
