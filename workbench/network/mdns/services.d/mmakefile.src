
include $(SRCDIR)/config/aros.cfg

# Install mdnsd's service config into the AROSTCP service-manager dir
# (db/services.d/), alongside the stack's own service scripts.
%copy_files_q mmake=workbench-network-mdns-svccfg files="$(filter-out mmakefile.src mmakefile, $(call WILDCARD, *))" \
    dst=$(AROS_SYSTEM)/Network/AROSTCP/db/services.d
