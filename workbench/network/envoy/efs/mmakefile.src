#
#   Rules to build the Envoy filesystem client, L:envoyfs-handler. It is also
#   installed as L:EnvoyFileSystem, the name in the mount files written by
#   Filesystem Imports (ours and the original).

include $(SRCDIR)/config/aros.cfg

FILES := efs_main efs_wire efs_mount efs_ops efs_rw efs_server

USER_INCLUDES := -I$(SRCDIR)/workbench/network/envoy/include
USER_CPPFLAGS := -D__NOLIBBASE__
USER_LDFLAGS  := -static
#USER_CPPFLAGS += -DDEBUG=1

#MM- workbench-network-envoy : workbench-network-envoy-efs workbench-network-envoy-efs-name
#MM workbench-network-envoy-efs : includes linklibs includes-copy-envoy \
#MM     workbench-network-envoy-nipc-includes workbench-network-envoy-services-includes

%build_module mmake=workbench-network-envoy-efs modname=envoyfs \
  modtype=handler files="$(FILES)" uselibs=""

$(AROS_FS)/EnvoyFileSystem : $(AROS_FS)/envoyfs-handler
	%fileactionmsg msg="Installing" file="$@"
	@$(CP) $< $@

#MM workbench-network-envoy-efs-name : workbench-network-envoy-efs
workbench-network-envoy-efs-name : $(AROS_FS)/EnvoyFileSystem
	@$(NOP)

%common
