#
#   Filesystem Exports: the preferences editor for the Envoy filesystem
#   exports (ENV:Envoy/EFS.prefs), installed in SYS:Prefs/Envoy/.

include $(SRCDIR)/config/aros.cfg

FILES := main args locale misc efsprefs efseditor

EXEDIR := $(AROSDIR)/Prefs/Envoy

USER_INCLUDES := -I$(SRCDIR)/workbench/network/envoy/include
#USER_CPPFLAGS := -DDEBUG=1

#MM- workbench-network-envoy : workbench-network-envoy-prefs-efs
#MM workbench-network-envoy-prefs-efs : includes linklibs includes-copy-envoy \
#MM     workbench-network-envoy-accounts-includes workbench-network-envoy-envoy-includes \
#MM     workbench-libs-muimaster-includes

%build_prog mmake=workbench-network-envoy-prefs-efs \
    progname=FilesystemExports targetdir=$(EXEDIR) \
    files=$(FILES)

%common
