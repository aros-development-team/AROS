# nipc.library test programs

include $(SRCDIR)/config/aros.cfg

EXEDIR := $(AROS_TESTS)/envoy
FILES  := nipctest

USER_INCLUDES := -I$(SRCDIR)/workbench/network/envoy/include

#MM- test : test-envoy
#MM test-envoy : includes linklibs includes-copy-envoy workbench-network-envoy-nipc-includes workbench-network-envoy-nipc-linklib

%build_progs mmake=test-envoy files=$(FILES) targetdir=$(EXEDIR) uselibs="nipc"

%common
