# services.library test program

include $(SRCDIR)/config/aros.cfg

EXEDIR := $(AROS_TESTS)/envoy
FILES  := svctest

USER_INCLUDES := -I$(SRCDIR)/workbench/network/envoy/include

#MM- test : test-envoy-services
#MM test-envoy-services : includes linklibs includes-copy-envoy \
#MM     workbench-network-envoy-nipc-includes workbench-network-envoy-nipc-linklib \
#MM     workbench-network-envoy-services-includes workbench-network-envoy-services-linklib

%build_progs mmake=test-envoy-services files=$(FILES) targetdir=$(EXEDIR) uselibs="nipc services"

%common
