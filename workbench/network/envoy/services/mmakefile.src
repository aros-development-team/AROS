#
#   Rules to build services.library (Envoy service broker, client side)

include $(SRCDIR)/config/aros.cfg

FILES := \
        services_init \
        services_find \
        services_list

USER_INCLUDES := -I$(SRCDIR)/workbench/network/envoy/include
USER_LDFLAGS  := -static
#USER_CPPFLAGS := -DDEBUG=1

#MM- workbench-network-envoy : workbench-network-envoy-services
#MM workbench-network-envoy-services : includes linklibs includes-copy-envoy workbench-network-envoy-nipc-includes

%build_module mmake=workbench-network-envoy-services modname=services \
  modtype=library files="$(FILES)" \
  uselibs=""

%common
