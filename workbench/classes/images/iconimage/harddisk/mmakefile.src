
include $(SRCDIR)/config/aros.cfg

USER_LDFLAGS := -static

#MM workbench-classes-images-harddisk : includes linklibs

# Installed with the image sets, where MUI keeps its .image files
%build_module mmake=workbench-classes-images-harddisk \
    modname=HardDisk modtype=image moduledir=System/Images/Zune \
    files=harddiskclass

%common
