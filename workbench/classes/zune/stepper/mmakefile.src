include $(SRCDIR)/config/aros.cfg

USER_CFLAGS := $(PARANOIA_CFLAGS)
USER_LDFLAGS := -static

FILES         := stepper
INCLUDE_FILES := stepper.h

#MM- workbench-classes-zune : workbench-classes-zune-stepper
#MM  workbench-classes-zune-stepper : includes

%build_module \
    mmake=workbench-classes-zune-stepper \
    modname=Stepper modtype=mcc \
    conffile=stepper.conf

%copy_includes path=zune

%common
%include_deps
