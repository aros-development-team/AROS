include $(SRCDIR)/config/aros.cfg

USER_CFLAGS := $(PARANOIA_CFLAGS)
USER_LDFLAGS := -static

FILES         := stepslider
INCLUDE_FILES := stepslider.h

#MM- workbench-classes-zune : workbench-classes-zune-stepslider
#MM  workbench-classes-zune-stepslider : includes

%build_module \
    mmake=workbench-classes-zune-stepslider \
    modname=Stepslider modtype=mcc \
    conffile=stepslider.conf

%copy_includes path=zune

%common
%include_deps
