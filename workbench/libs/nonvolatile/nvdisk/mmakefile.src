
include $(SRCDIR)/config/aros.cfg

USER_LDFLAGS := -static

%get_archincludes modname=nvdisk \
    includeflag=TARGET_NVDISK_INCLUDES \
    maindir=workbench/libs/nonvolatile/nvdisk

# nvdisk_arch.h can be overridden in an arch-specific directory: the arch
# includes come first, then this directory for the generic fallback.
USER_INCLUDES := $(TARGET_NVDISK_INCLUDES) -I$(SRCDIR)/$(CURDIR)

FUNCS := meminfonvd \
	 readnvddata \
	 setnvdprotection \
	 writenvddata \
	 deletenvddata \
	 getnvditemlist

#MM workbench-libs-nvdisk-includes : \
#MM     kernel-exec-includes \
#MM     kernel-dos-includes \
#MM     includes-copy
#MM- workbench-libs-nvdisk : linklibs

%build_module mmake=workbench-libs-nvdisk \
    modname=nvdisk modtype=library \
    files="nvdisk_init $(FUNCS)"

%common
