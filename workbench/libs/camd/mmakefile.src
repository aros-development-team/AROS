
include $(SRCDIR)/config/aros.cfg

USER_LDFLAGS := -static

FILES :=    drivers clusters init camdwait mididistr midifromdriver \
	    midimsgtype2 miditodriver receiverproc strings sysexdistr \
	    unlinkmidilink getmidilinkfromownernode camdclock endpoint_registry \
	    provider_contract legacy_driver_adapter native_event_queue \
	    native_event_pump native_event_worker legacy_port_refs \
	    native_worker_fanout legacy_output_backend \
	    legacy_driver_output_backend identity_map identity_file \
	    identity_store_recovery identity_store_aros legacy_identity_key \
	    legacy_identity_set driver_endpoints endpoint_client

FUNCS := \
    lockcamd \
    unlockcamd \
    createmidia \
    deletemidi \
    setmidiattrsa \
    getmidiattrsa \
    nextmidi \
    findmidi  \
    flushmidi \
    addmidilinka \
    removemidilink \
    setmidilinkattrsa \
    getmidilinkattrsa \
    nextclusterlink \
    nextmidilink \
    midilinkconnected \
    nextcluster \
    findcluster \
    putmidi \
    getmidi \
    waitmidi \
    putsysex \
    getsysex \
    querysysex \
    skipsysex \
    getmidierr \
    midimsgtype \
    midimsglen \
    parsemidi \
    openmididevice \
    closemididevice \
    rethinkcamd \
    startclusternotify \
    endclusternotify \
    goodputmidi \
    midi2driver \
    getclusterattrsa \
    camdtime \
    startclusterwatcha \
    endclusterwatch \
    getclusterwatchevent \
    obtainendpointsnapshot \
    releaseendpointsnapshot \
    getendpointinfo \
    openendpointsession \
    closeendpointsession \
    putendpointmidi \
    putendpointsysex \
    drainendpointsession \
    getendpointmidi \
    startendpointwatch \
    getendpointwatchevent \
    endendpointwatch

#MM workbench-libs-camd-includes : \
#MM     kernel-exec-includes \
#MM     kernel-dos-includes \
#MM     kernel-utility-includes \
#MM     includes-copy

#MM- workbench-libs-camd : linklibs workbench-libs-uuid-includes

%build_module mmake=workbench-libs-camd \
    modname=camd modtype=library \
    files="$(FUNCS) $(FILES) camd_init"

INCLUDE_FILES := camdendpoint.h

%copy_includes path=midi

%common
