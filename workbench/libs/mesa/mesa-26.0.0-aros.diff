          screen->has_svm = !ret;
+#if !defined(__AROS__)
          if (!screen->has_svm)
             os_munmap(screen->svm_cutout, screen->svm_cutout_size);
+#endif
          break;
       } while ((start + screen->svm_cutout_size) < BITFIELD64_MASK(limit_bit));
    }
