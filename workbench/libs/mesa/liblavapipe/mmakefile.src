#   Build liblavapipe.a — Mesa's lavapipe, Vulkan on llvmpipe
#
#   The lavapipe frontend (src/gallium/frontends/lavapipe) with the pieces
#   its meson target links around it: the software pipe loader with the
#   null and wrapper winsyses, and xmlconfig for the drirc options the
#   loader and the driver parse. The generated entrypoints, drirc tables
#   and the loader's static driconf come from mesa3d-generate-lavapipe.
#   The entrypoint tables reference the lvp_*/wsi_*/vk_common_* functions
#   weakly, so a module links this archive, libvulkan_wsi and
#   libvulkan_runtime with --whole-archive, as meson's link_whole does.

include $(SRCDIR)/config/aros.cfg

CUR_MESADIR := src/gallium/frontends/lavapipe
include $(SRCDIR)/$(CURDIR)/../mesa.cfg

ifeq ($(OPT_LLVM),)
ifneq ($(TARGET_LLVM_VER),)
OPT_LLVM := $(TARGET_LLVM_VER)
else
OPT_LLVM := 11.0.0
endif
endif
LLVM_VERSION_MAJOR := $(word 1,$(subst ., ,$(OPT_LLVM)))
LLVM_VERSION_MINOR := $(word 2,$(subst ., ,$(OPT_LLVM)))
LLVM_VERSION_HEX := 0x$(shell printf "%02x%02x" $(LLVM_VERSION_MAJOR) $(LLVM_VERSION_MINOR))

LVP_GENDIR := $(top_builddir)/$(CUR_MESADIR)
VK_RT_GENDIR := $(top_builddir)/src/vulkan/runtime
VK_UTIL_GENDIR := $(top_builddir)/src/vulkan/util
WSI_GENDIR := $(top_builddir)/src/vulkan/wsi
PIPE_LOADER_DIR := src/gallium/auxiliary/pipe-loader
SW_WINSYS_DIR := src/gallium/winsys/sw

#MM mesa3d-linklib-lavapipe : mesa3d-generate-lavapipe mesa3d-generate-vulkan-runtime mesa3d-generate-vulkan-wsi \
#MM     mesa3d-linklib-llvmpipe mesa3d-linklib-vulkan-runtime mesa3d-linklib-vulkan-wsi \
#MM     mesa3d-linklib-compiler mesa3d-linklib-mesautil linklibs-galliumauxiliary

# liblvp_files in the frontend's meson.build, minus the android file
LVP_SOURCES := \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_lower_cooperative_matrix \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_lower_descriptor_heaps \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_lower_exec_graph \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_lower_input_attachments \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_lower_pipeline_layout \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_lower_push_constants \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_lower_ray_queries \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_lower_sparse_residency \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_opt_robustness \
    $(top_srcdir)/$(CUR_MESADIR)/nir/lvp_nir_ray_tracing \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_acceleration_structure \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_device \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_device_generated_commands \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_cmd_buffer \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_descriptor_set \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_execute \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_util \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_image \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_formats \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_pipe_sync \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_pipeline \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_pipeline_cache \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_query \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_ray_tracing_pipeline \
    $(top_srcdir)/$(CUR_MESADIR)/lvp_wsi

# The software pipe loader (libpipe_loader_static) and the winsyses the
# lavapipe target links (libws_null, libwsw). Neither DRI nor KMS is
# built, so the loader probes the null winsys and llvmpipe draws to its
# own memory.
LVP_LOADER_SOURCES := \
    $(top_srcdir)/$(PIPE_LOADER_DIR)/pipe_loader \
    $(top_srcdir)/$(PIPE_LOADER_DIR)/pipe_loader_sw \
    $(top_srcdir)/$(SW_WINSYS_DIR)/null/null_sw_winsys \
    $(top_srcdir)/$(SW_WINSYS_DIR)/wrapper/wrapper_sw_winsys \
    $(top_srcdir)/src/util/xmlconfig

LVP_GEN_SOURCES := \
    $(LVP_GENDIR)/lvp_entrypoints \
    $(LVP_GENDIR)/lvp_drirc

# The runtime's acceleration structure build needs shaders compiled with
# glslang at build time, which is not available: lavapipe is built without
# ray tracing (LVP_NO_RAY_TRACING in lvp_device.c, from the AROS patch) and
# the build entry points it still links are stubs.
LVP_LOCAL_SOURCES := \
    $(SRCDIR)/$(CURDIR)/lavapipe_noraytracing

USER_INCLUDES += \
    -iquote $(SRCDIR)/$(CURDIR)/../aros_compat \
    -iquote $(top_srcdir)/$(CUR_MESADIR) \
    -iquote $(top_srcdir)/src \
    -iquote $(top_srcdir)/src/util \
    -iquote $(top_srcdir)/src/compiler \
    -iquote $(top_srcdir)/src/compiler/nir \
    -iquote $(top_srcdir)/src/gallium/include \
    -iquote $(top_srcdir)/src/gallium/auxiliary \
    -iquote $(top_srcdir)/src/gallium/winsys \
    -iquote $(top_srcdir)/src/gallium/drivers \
    -iquote $(top_srcdir)/src/gallium/drivers/llvmpipe \
    -iquote $(top_srcdir)/src/vulkan/runtime \
    -iquote $(top_srcdir)/src/vulkan/util \
    -iquote $(top_srcdir)/src/vulkan/wsi \
    -iquote $(top_srcdir)/include \
    -iquote $(top_builddir)/src \
    -iquote $(top_builddir)/src/util \
    -iquote $(top_builddir)/src/compiler \
    -iquote $(top_builddir)/src/compiler/nir \
    -iquote $(top_builddir)/src/gallium/auxiliary \
    -iquote $(LVP_GENDIR) \
    -iquote $(VK_RT_GENDIR) \
    -iquote $(VK_UTIL_GENDIR) \
    -iquote $(WSI_GENDIR) \
    -I $(SRCDIR)/$(CURDIR)/../aros_compat \
    -I $(top_srcdir)/src/gallium/include \
    -I $(top_srcdir)/src/gallium/winsys \
    -I $(top_srcdir)/src/include \
    -I $(LVP_GENDIR) \
    -I $(VK_RT_GENDIR) \
    -I $(VK_UTIL_GENDIR) \
    -I $(WSI_GENDIR) \
    -I $(AROS_INCLUDES)

# xmlconfig without expat (WITH_XMLCONFIG=0 reads the generated
# driconf_static.h) and without regex, as the amdgpu hidd builds it.
USER_CPPFLAGS += \
    -DNO_AMIGA_LINKAGE_TYPES \
    -DGALLIUM_LLVMPIPE -DDRAW_LLVM_AVAILABLE=1 -DLLVM_AVAILABLE \
    -DHAVE_LLVM=$(LLVM_VERSION_HEX) \
    -DMESA_LLVM_VERSION_STRING=\"$(OPT_LLVM)\" \
    -DPACKAGE_VERSION=\"$(MESAGLVERSION)\" \
    -DWITH_XMLCONFIG=0 -DNO_REGEX \
    -DLVP_NO_RAY_TRACING \
    -DMESA_VK_LOG=0 \
    -DNDEBUG \
    -include $(SRCDIR)/$(CURDIR)/../aros_compat/aros_mesa_compat.h

USER_CFLAGS += $(MESA_NOWARNFLAGS)

%build_linklib mmake=mesa3d-linklib-lavapipe \
    libname=lavapipe \
    libdir=$(top_libdir) \
    objdir=$(top_builddir)/$(CUR_MESADIR) \
    files="$(LVP_SOURCES) $(LVP_LOADER_SOURCES) $(LVP_GEN_SOURCES) $(LVP_LOCAL_SOURCES)"

# lvp_entrypoints (vk_entrypoints_gen), lvp_drirc (lvp_drirc_gen) and
# driconf_static.h (for xmlconfig) are what meson generates for the
# frontend and the loader; git_sha1.h stands in for the one meson writes
# at the tree's root (a release tarball has no git revision).
#MM
mesa3d-generate-lavapipe :
	@$(ECHO) "Generating lavapipe entrypoints..."
	@$(MKDIR) -p $(LVP_GENDIR)
	@VK_XML=$(top_srcdir)/src/vulkan/registry/vk.xml && \
	PYTHONPATH="$(top_srcdir)/src/vulkan/util:$(top_srcdir)/src/util:$(top_srcdir)/src:$$PYTHONPATH" && \
	export PYTHONPATH && \
	python3 $(top_srcdir)/src/vulkan/util/vk_entrypoints_gen.py \
	  --xml "$$VK_XML" --beta false --proto --weak \
	  --prefix lvp \
	  --out-c "$(LVP_GENDIR)/lvp_entrypoints.c" \
	  --out-h "$(LVP_GENDIR)/lvp_entrypoints.h" && \
	python3 $(top_srcdir)/$(CUR_MESADIR)/lvp_drirc_gen.py \
	  --import-path $(top_srcdir)/src/util \
	  --drirc-src "$(LVP_GENDIR)/lvp_drirc.c" \
	  --drirc-hdr "$(LVP_GENDIR)/lvp_drirc.h" \
	  --validate $(top_srcdir)/$(CUR_MESADIR)/00-lavapipe-defaults.conf && \
	python3 $(top_srcdir)/src/util/driconf_static.py \
	  $(top_srcdir)/src/util/00-mesa-defaults.conf \
	  "$(LVP_GENDIR)/driconf_static.h" && \
	$(ECHO) '#define MESA_GIT_SHA1 ""' > "$(LVP_GENDIR)/git_sha1.h"
	@$(ECHO) "lavapipe entrypoints generated."

%common
