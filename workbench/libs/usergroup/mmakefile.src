#
#   Rules to build usergroup.library.

include $(SRCDIR)/config/aros.cfg

FILES := \
        usergroup \
        error \
        credential \
        resource \
        getutent \
        getpwent \
        getgrent \
        initgroups \
        loginname \
        time \
        getpass \
        getsalt \
        crypt \
        console \
        random \
        usergroup_security

#USER_CPPFLAGS := -DDEBUG=1
USER_LDFLAGS := -static

#MM workbench-libs-usergroup : includes linklibs kernel-security-includes
%subtarget parentmmake=workbench-libs mmake=workbench-libs-usergroup

# usergroup.conf sets norootrellibs (see tools/genmodule/config.h): code that
# runs with the root base, such as UserGroup__Init and UserGroup__Expunge, must
# not call posixc.library or stdc.library.
%build_module mmake=workbench-libs-usergroup modname=usergroup \
  modtype=library files="$(FILES)" \
  uselibs=""

INCLUDE_FILES:=usergroup.h
%copy_includes path=libraries includes=$(INCLUDE_FILES)

INCLUDE_FILES:=utmp.h
%copy_includes includes=$(INCLUDE_FILES)

%common
