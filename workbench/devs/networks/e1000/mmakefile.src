
include $(SRCDIR)/config/aros.cfg


FILES := handler unit e1000
INTELCOREFILES := e1000_api e1000_phy e1000_mac e1000_nvm e1000_manage
INTELMACFILES := e1000_82540 e1000_82541 e1000_82542 e1000_82543

USER_LDFLAGS := -static
USER_CPPFLAGS :=  \
        -D__OOP_NOLIBBASE__ \
        -D__OOP_NOMETHODBASES__ \
        -D__OOP_NOATTRBASES__
USER_CFLAGS := $(CFLAGS_GNU99)

#
# Little-endian CPUs only: the registers are read and written raw (readl and
# writel in e1000_osdep.h are plain mmio_inl/mmio_outl), and only some of the
# descriptor fields are converted to little-endian.
#
#MM- workbench-devs-networks-e1000 : workbench-devs-networks-e1000-$(AROS_TARGET_CPU)
#MM- workbench-devs-networks-e1000-i386 : workbench-devs-networks-e1000-normal
#MM- workbench-devs-networks-e1000-x86_64 : workbench-devs-networks-e1000-normal
#MM- workbench-devs-networks-e1000-riscv : workbench-devs-networks-e1000-normal
#MM- workbench-devs-networks-e1000-riscv64 : workbench-devs-networks-e1000-normal

#MM- workbench-devs-networks-e1000-quick : workbench-devs-networks-e1000-normal-quick

%build_module mmake=workbench-devs-networks-e1000-normal \
    modname=e1000 modtype=device \
    files="e1000_init $(FILES) $(INTELCOREFILES) $(INTELMACFILES)" \
    objdir=$(OBJDIR)/normal moduledir=Devs/Networks uselibs="hiddstubs"

