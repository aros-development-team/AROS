#MM- workbench-devs-networks-gnu: \
#MM     workbench-devs-networks-atheros5000

#
# Drivers for plug-in cards: PCI, and PCMCIA on the classic machines. They are
# worth having wherever such a card can be fitted - x86, and m68k or ppc with a
# PCI bridge or a PCMCIA slot - but on ARM the network hardware is part of the
# SoC (bcmgenet, dwmac) or hangs off USB, so shipping them there only fills
# DEVS:Networks with drivers for absent hardware. That is not merely untidy:
# anything enumerating the directory has to open them to ask what they are, and
# a driver initialising against hardware that is not present can take the
# machine down.
#
#MM- workbench-devs-networks-cards-i386   : workbench-devs-networks-cards
#MM- workbench-devs-networks-cards-x86_64 : workbench-devs-networks-cards
#MM- workbench-devs-networks-cards-m68k   : workbench-devs-networks-cards
#MM- workbench-devs-networks-cards-ppc    : workbench-devs-networks-cards

#
# On-chip and on-board network hardware, found through the device tree rather
# than a probeable bus, so it is the machine that decides whether the driver
# makes sense. Both were built only when asked for by name until now, which
# left a plain build without either the WiFi or the ethernet driver.
#
#MM- workbench-devs-networks-soc-raspi: \
#MM     workbench-devs-networks-bcmgenet \
#MM     workbench-devs-networks-bwfm

#MM- workbench-devs-networks-cards: \
#MM     workbench-devs-networks-broadcom4400 \
#MM     workbench-devs-networks-etherlink3 \
#MM     workbench-devs-networks-intelpro100 \
#MM     workbench-devs-networks-nvidianet \
#MM     workbench-devs-networks-prism2 \
#MM     workbench-devs-networks-rhine \
#MM     workbench-devs-networks-rtl8029 \
#MM     workbench-devs-networks-rtl8139
