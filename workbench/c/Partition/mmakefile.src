include $(SRCDIR)/config/aros.cfg

FILES := main args

#MM- workbench-c : workbench-c-partition
#MM workbench-c-partition : includes linklibs linklibs-ptedit

USER_LDFLAGS := -static

%build_prog mmake=workbench-c-partition \
    progname=Partition targetdir=$(AROS_C) \
    files=$(FILES) uselibs="ptedit" coverageinstr=no

%common
