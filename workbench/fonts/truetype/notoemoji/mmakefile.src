include $(SRCDIR)/config/aros.cfg

#MM- fonts-truetype : fonts-truetype-notoemoji
#MM- fonts-truetype-quick : fonts-truetype-notoemoji
#MM- fonts-truetype-notoemoji : fonts-truetype-notoemoji-files

# ConsoleNG opens this color bitmap face as a fallback through FreeType.
# Do not register .font/.otag primary-font wrappers without qualifying the
# diskfont monochrome preload and fixed-width font requester paths separately.
%copy_files_q mmake=fonts-truetype-notoemoji-files \
    files="NotoColorEmoji.ttf LICENSE-NotoEmoji.txt" \
    dst=$(AROSDIR)/Fonts/TrueType
