include $(SRCDIR)/config/aros.cfg

# DejaVu Sans and DejaVu Sans Mono 2.37, unchanged from the release
# archive (dejavu-fonts-ttf-2.37.tar.bz2). They cover the scripts and
# symbols that Open Sans and Vera do not (Greek, Cyrillic, maths, arrows,
# box drawing, combining marks), for unitext.library and its classes.

#MM- fonts-truetype : fonts-truetype-dejavu
#MM- fonts-truetype-quick : fonts-truetype-dejavu
#MM- fonts-truetype-dejavu : fonts-truetype-dejavu-ttf

%copy_files_q mmake=fonts-truetype-dejavu-ttf files="DejaVuSans.ttf DejaVuSansMono.ttf DejaVu-LICENSE.txt" \
    dst=$(AROSDIR)/Fonts/TrueType
