/* An example of mounting ISO image via fdsk.device */

FileSystem	= ODFileSystem-handler
Device		= fdsk.device
Unit		= 0
BlockSize	= 2048
Surfaces	= 1
BlocksPerTrack	= 1
LowCyl		= 0
HighCyl		= 0
Reserved	= 0
BufMemType	= 0
DosType		= 0x43443031
StackSize	= 32768
GlobVec		= -1
ForceLoad	= 1
Activate	= 1
