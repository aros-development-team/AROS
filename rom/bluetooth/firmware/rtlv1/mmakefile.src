include $(SRCDIR)/config/aros.cfg

USER_LDFLAGS := -static
USER_INCLUDES := -I$(SRCDIR)/rom/bluetooth/bluetooth/include \
                 -I$(SRCDIR)/rom/bluetooth/stack/include

FILES := rtlbtv1

#MM- kernel-bluetooth-firmware-rtlv1 : kernel-bluetooth-library-includes

%build_module_library mmake=kernel-bluetooth-firmware-rtlv1 \
    modname=rtlbtv1 modtype=library modsuffix="fwl" \
    moduledir=Devs/Bluetooth/FWLoaders \
    files="$(FILES)"

%common
