include $(SRCDIR)/config/aros.cfg

FILES :=    \
    bluetooth.library \
    objects \
    classes \
    firmware \
    aes128 \
    hwtask \
    hwconn \
    config \
    numtostr \
    popupicon \
    popup \
    debug

#MM kernel-bluetooth-library-includes :                         \
#MM     kernel-exec-includes                                    \
#MM     kernel-dos-includes                                     \
#MM     kernel-utility-includes                                 \
#MM     kernel-bluetooth-btclass-includes                       \
#MM     includes-copy
#MM- kernel-bluetooth-library : linklibs linklibs-btcore

USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)/include -I$(SRCDIR)/rom/bluetooth/stack/include
USER_CPPFLAGS := -D__BLUETOOTH_NOLIBBASE__
#USER_CPPFLAGS += -DDEBUG=1
USER_LDFLAGS := -static

%build_module mmake=kernel-bluetooth-library                    \
    modname=bluetooth modtype=library                           \
    files="$(FILES)"                                            \
    uselibs="btcore debug"

INCLUDE_FILES := $(call WILDCARD, include/libraries/*.h)
%copy_includes path=libraries dir=include/libraries

%common
