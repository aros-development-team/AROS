include $(SRCDIR)/config/aros.cfg

USER_LDFLAGS := -static
USER_CPPFLAGS := -DMUIMASTER_YES_INLINE_STDARG

FILES := btsdp.class debug

#MM- kernel-bluetooth-classes-btsdp : kernel-bluetooth-btclass kernel-bluetooth-library-includes

%build_module_library mmake=kernel-bluetooth-classes-btsdp \
    modname=btsdp modtype=btclass modsuffix="class" \
    files="$(FILES)"

%common
