include $(SRCDIR)/config/aros.cfg

USER_LDFLAGS := -static
USER_INCLUDES := -I$(SRCDIR)/rom/bluetooth/stack/include
FILES := btaudio.class audio audio_library stream

#MM- kernel-bluetooth-classes-btaudio : kernel-bluetooth-btclass kernel-bluetooth-library-includes \
#MM     linklibs-btcore workbench-devs-AHI

%build_module_library mmake=kernel-bluetooth-classes-btaudio \
    modname=btaudio modtype=btclass modsuffix="class" \
    files="$(FILES)" uselibs="btcore"

%common
