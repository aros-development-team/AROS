
include $(SRCDIR)/config/aros.cfg

#MM- kernel-gameport : includes linklibs

USER_INCLUDES := -I$(SRCDIR)/rom/devs

USER_CPPFLAGS := \
               -DUSE_EXEC_DEBUG \
               -D__OOP_NOLIBBASE__
USER_LDFLAGS := -static

ifneq ($(ROM_OPTIMIZATION_CFLAGS),)
OPTIMIZATION_CFLAGS := $(ROM_OPTIMIZATION_CFLAGS)
endif

%build_module mmake=kernel-gameport \
  modname=gameport modtype=device \
  files=gameport

#MM includes-copy

INCLUDE_FILES := $(call WILDCARD, include/*.h)
%copy_includes path=devices dir=include
