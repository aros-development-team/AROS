include $(SRCDIR)/config/aros.cfg

AFS_INLINE_REQUESTERS ?= 1
-include $(SRCDIR)/arch/$(CPU)-$(ARCH)/filesys/afs/make.opts

FILES := main \
	bitmap \
	cache \
	checksums \
	error \
	extstrings \
	filehandles1 \
	filehandles2 \
	filehandles3 \
	afs_security \
	hashing \
	misc \
	os_aros_support \
	volumes \
   	validator

ifeq ($(AFS_INLINE_REQUESTERS),0)
FILES += os_aros_requesters
endif

#MM- kernel-fs-afs : includes linklibs kernel-security-includes kernel-task-includes

USER_CPPFLAGS := \
               -DUSE_EXEC_DEBUG \
	       -DAFS_INLINE_REQUESTERS=$(AFS_INLINE_REQUESTERS) \
	       -D__INTUITION_NOLIBBASE__ \
	       -DADATE="\"$(shell date '+%d.%m.%Y')\""
USER_LDFLAGS := -static

ifneq ($(ROM_OPTIMIZATION_CFLAGS),)
OPTIMIZATION_CFLAGS := $(ROM_OPTIMIZATION_CFLAGS)
endif

%build_module mmake=kernel-fs-afs \
    modname=afs modtype=handler \
    files="$(FILES)"

%common
