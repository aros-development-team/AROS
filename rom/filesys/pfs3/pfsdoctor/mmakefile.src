
include $(SRCDIR)/config/aros.cfg

PFS3DIR := $(SRCDIR)/rom/filesys/pfs3/fs

FILES := \
	access \
	device \
	fullscan \
	standardscan \
	stats \
	console \
	$(PFS3DIR)/endian

USER_CPPFLAGS := \
	-DLARGE_FILE_SIZE=1 \
	-DDELDIR=1 \
	-DVERSION23=1 \
	-DNO_GUI=1 \
	-DREVISION=19 \
	-DREVDATE="\"$(shell date '+%d.%m.%Y')\"" \
	-DADATE="\"$(shell date '+%d.%m.%Y')\""

USER_INCLUDES := -I$(PFS3DIR)

EXEDIR = $(AROSDIR)/C

%build_prog mmake=workbench-devs-pfs3-c-pfsdoctor \
    progname=PFSDoctor targetdir=$(EXEDIR) files=$(FILES) 

%common
