#
# fido.class: the FIDO (CTAPHID) interface of USB security keys, as
# fido.device.

include $(SRCDIR)/config/aros.cfg

USER_LDFLAGS := -static

FILES :=    fido.class dev debug

#MM- kernel-usb-classes-fido : kernel-usb-usbclass kernel-usb-poseidon-includes

%build_module_library mmake=kernel-usb-classes-fido \
    modname=fido modtype=usbclass modsuffix="class" \
    files="$(FILES)"

%common
