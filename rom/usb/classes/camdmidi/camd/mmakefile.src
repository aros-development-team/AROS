
include $(SRCDIR)/config/aros.cfg

OBJDIR := $(GENDIR)/$(CURDIR)
CAMDOBJDIR := $(OBJDIR)/../camdusbmidi/arch

SRCFILE := poseidonusb

USER_INCLUDES := -I$(OBJDIR)/../include -iquote $(SRCDIR)/$(CURDIR)/..

#MM kernel-usb-classes-camdusbmidi-object : kernel-usb-classes-camd-usbmidi-includes
#MM- kernel-usb-classes-camdusbmidi-object-quick : kernel-usb-classes-camdusbmidi-object

$(OBJDIR)/%.o : $(SRCDIR)/$(CURDIR)/%.c | $(OBJDIR)
	%compile_q

# The class writes this blob to DEVS:Midi/ and camd.library LoadSeg()s it, so
# it has to stay a relocatable ELF: OpenMidiDevice() only accepts the driver
# if MidiDeviceData.Init points inside the loaded seglist, which needs the
# relocations intact.
#
# It is embedded as a C byte array, as btmidi.class does, rather than with
# "ld -r --format binary", which the m68k ld of binutils 2.32 refuses.
$(OBJDIR)/$(SRCFILE)_blob.c : $(OBJDIR)/$(SRCFILE).o | $(OBJDIR)
	$(Q)$(ECHO) "Embedding  $(SRCFILE)..."
	$(Q)( $(ECHO) "/* Generated from $(SRCFILE).o: the CAMD driver as bytes */"; \
	      $(ECHO) "#include <exec/types.h>"; \
	      $(ECHO) "const UBYTE poseidonusb_blob[] = {"; \
	      od -An -v -tx1 $< | $(SED) -e 's/ *\([0-9a-f][0-9a-f]\)/0x\1,/g'; \
	      $(ECHO) "};"; \
	      $(ECHO) "const ULONG poseidonusb_blob_size = sizeof(poseidonusb_blob);" ) > $@

$(CAMDOBJDIR)/$(SRCFILE).bin.o : $(OBJDIR)/$(SRCFILE)_blob.c | $(CAMDOBJDIR)
	%compile_q

#MM
kernel-usb-classes-camdusbmidi-object : $(CAMDOBJDIR)/$(SRCFILE).bin.o

GLOB_MKDIRS += $(OBJDIR) $(CAMDOBJDIR)

%common
