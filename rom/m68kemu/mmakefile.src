# Copyright (C) 2026, The AROS Development Team. All rights reserved.
#
# m68kemu.library — Transparent M68K emulation for AmigaOS hunk binaries
# Uses Moira (MIT license) as the CPU core
#
# Skip on m68k targets — no need to emulate m68k on m68k
#
# m68kemu_shadow_layouts.h takes its native struct offsets from offsetof(), so
# they follow the target. It tells a pointer from a LONG by a native member of
# 8 bytes, though, so only build where pointers have that size.

include $(SRCDIR)/config/aros.cfg

#MM- kernel-m68kemu : kernel-m68kemu-$(AROS_TARGET_CPU)
#MM- kernel-m68kemu-x86_64 : kernel-m68kemu-library
#MM- kernel-m68kemu-aarch64 : kernel-m68kemu-library
#MM- kernel-m68kemu-riscv64 : kernel-m68kemu-library

#MM kernel-m68kemu-library-includes : \
#MM     kernel-expansion-includes \
#MM     kernel-keymap-includes \
#MM     kernel-layers-includes \
#MM     kernel-log-includes \
#MM     kernel-timer-includes \
#MM     kernel-utility-includes \
#MM     workbench-libs-asl-includes \
#MM     workbench-libs-cgfx-includes \
#MM     workbench-libs-commodities-includes \
#MM     workbench-libs-datatypes-includes \
#MM     workbench-libs-diskfont-includes \
#MM     workbench-libs-gadtools-includes \
#MM     workbench-libs-icon-includes \
#MM     workbench-libs-iffparse-includes \
#MM     workbench-libs-locale-includes \
#MM     workbench-libs-workbench-includes

USER_CPPFLAGS := -DNO_INLINE_STDARG -I$(SRCDIR)/$(CURDIR)/Moira
# Moira uses if constexpr (<integer>) - narrowing the condition to bool is only
# well formed since P1401R5, which clang implements from 12 on (clang 11 errors).
USER_CXXFLAGS := $(CXXFLAGS_CXX20) $(NOWARN_NARROWING)
USER_LDFLAGS := -static

M68KEMU_FILES := \
    m68kemu_init \
    m68kemu_run \
    m68kemu_engine \
    m68kemu_memory \
    m68kemu_runtime \
    m68kemu_thunks \
    m68kemu_shadow \
    m68kemu_m68klib \
    m68kemu_stubs \
    m68kemu_math \
    m68kemu_rexx \
    m68kemu_tags \
    m68kemu_icon \
    m68kemu_tasks \
    m68kemu_devices \
    m68kemu_boopsi \
    m68kemu_thunks_gen

M68KEMU_CXXFILES := \
    m68kemu_moira \
    Moira/Moira/Moira \
    Moira/Moira/MoiraDebugger

%build_module mmake=kernel-m68kemu-library \
    modname=m68kemu modtype=library \
    files="$(M68KEMU_FILES)" \
    cxxfiles="$(M68KEMU_CXXFILES)" \
    uselibs="stdc++ posixc stdcio stdc"

%common

# ── Shadow layout regeneration ──
# The checked-in m68kemu_shadow_layouts.h is the same for every target: it
# names the native members and the compiler places them. It is written by
#   gen_shadow_layouts.py m68k_offsets.txt > m68kemu_shadow_layouts.h
# Requires: python3. The AmigaOS NDK headers and an m68k compiler are only
# needed to add structs to m68k_offsets.txt (gen_offset_extractor.py).
# Note that gen_shadow_layouts.py only treats a field as a pointer when the
# native one is 8 bytes wide, so it needs fixing before it can serve a
# 32bit target.
