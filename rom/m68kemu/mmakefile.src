# Copyright (C) 2026, The AROS Development Team. All rights reserved.
#
# m68kemu.library — Transparent M68K emulation for AmigaOS hunk binaries
# Uses Moira (MIT license) as the CPU core
#
# Skip on m68k targets — no need to emulate m68k on m68k
#
# The checked-in m68kemu_shadow_layouts.h holds the native struct offsets of a
# 64bit build (an_Parent is at 8 there, but at 4 on a 32bit target), so only
# build where those are valid until the layouts are generated per target.

include $(SRCDIR)/config/aros.cfg

#MM- kernel-m68kemu : kernel-m68kemu-$(AROS_TARGET_CPU)
#MM- kernel-m68kemu-x86_64 : kernel-m68kemu-library
#MM- kernel-m68kemu-aarch64 : kernel-m68kemu-library
#MM- kernel-m68kemu-riscv64 : kernel-m68kemu-library

USER_CPPFLAGS := -DNO_INLINE_STDARG -I$(SRCDIR)/$(CURDIR)/Moira
# Moira uses if constexpr (<integer>) - narrowing the condition to bool is only
# well formed since P1401R5, which clang implements from 12 on (clang 11 errors).
USER_CXXFLAGS := $(CXXFLAGS_CXX20) $(NOWARN_NARROWING)
USER_LDFLAGS := -static

M68KEMU_FILES := \
    m68kemu_init \
    m68kemu_run \
    m68kemu_memory \
    m68kemu_thunks \
    m68kemu_shadow \
    m68kemu_m68klib \
    m68kemu_stubs \
    m68kemu_thunks_gen

M68KEMU_CXXFILES := \
    m68kemu_moira \
    Moira/Moira/Moira \
    Moira/Moira/MoiraDebugger

%build_module mmake=kernel-m68kemu-library \
    modname=m68kemu modtype=library \
    files="$(M68KEMU_FILES)" \
    cxxfiles="$(M68KEMU_CXXFILES)" \
    uselibs="stdc++ posixc stdc"

%common

# ── Shadow layout regeneration (needed for any new target architecture) ──
# The checked-in m68kemu_shadow_layouts.h was generated for x86_64.
# To regenerate it, compile the probe gen_offset_extractor.py writes with both
# the m68k and the target compiler, then feed the two offset dumps to
#   gen_shadow_layouts.py m68k.txt aros.txt > m68kemu_shadow_layouts.h
# Requires: python3 and the AmigaOS NDK headers for the m68k side.
# Note that gen_shadow_layouts.py only treats a field as a pointer when the
# native one is 8 bytes wide, so it needs fixing before it can serve a
# 32bit target.
